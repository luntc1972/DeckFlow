<!--
  DIST-01 — standalone-exe publish profile for DeckFlow.Studio (win-x64, self-contained, single-file).

  These publish properties live HERE, not in DeckFlow.Studio.csproj, so that the default
  build / dotnet run / CI / Docker behavior is completely unchanged. The profile is selected
  only when explicitly passed to dotnet publish: -p:PublishProfile=win-x64-selfcontained
  (as done by scripts/publish-studio.ps1 and scripts/publish-studio.sh).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- ReadyToRun is intentionally NOT set (left at the default off).
         It can be enabled for faster cold-start at the cost of ~15 MB extra;
         not worth it for a single-operator tool that starts once. -->
  </PropertyGroup>
</Project>
