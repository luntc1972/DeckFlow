@model DeckFlow.Web.Models.MetaGapViewModel
@using DeckFlow.Web.Configuration
@using DeckFlow.Web.Services.Tools
@using Microsoft.Extensions.Options
@inject IOptions<AiPlatformOptions> AiPlatformOptionsAccessor
@{
    ViewData["Title"] = "cEDH Meta Gap Analysis for Your Deck";
    ViewData["Description"] = "Find what your cEDH deck is missing versus the competitive Commander metagame. Includes a one-paste gap-analysis prompt from your decklist.";
    var currentStep = Math.Clamp(Model.Request.WorkflowStep, 1, 3);
    var aiPlatform = AiPlatform.Normalize(Model.Request.TargetAiPlatform);
    var platformList = AiPlatformCopy.PlatformList(AiPlatformOptionsAccessor.Value.GeminiEnabled);
    var selectedReferenceIndexes = Model.Request.SelectedReferenceIndexes ?? new List<int>();
    const int pageSize = 10;

    static string FormatTimePeriodLabel(DeckFlow.Web.Models.CedhMetaTimePeriod value) => value switch
    {
        DeckFlow.Web.Models.CedhMetaTimePeriod.ONE_MONTH => "One Month",
        DeckFlow.Web.Models.CedhMetaTimePeriod.THREE_MONTHS => "Three Months",
        DeckFlow.Web.Models.CedhMetaTimePeriod.SIX_MONTHS => "Six Months",
        DeckFlow.Web.Models.CedhMetaTimePeriod.ONE_YEAR => "One Year",
        DeckFlow.Web.Models.CedhMetaTimePeriod.ALL_TIME => "All Time",
        DeckFlow.Web.Models.CedhMetaTimePeriod.POST_BAN => "Post-Ban",
        _ => value.ToString().Replace('_', ' ')
    };
}

<section class="hero">
    <h1>cEDH Meta Gap</h1>
    <p class="page-lede">Generate a prompt analyzing your deck against current cEDH meta. Paste into @platformList.</p>
    <p class="lede">Compare your deck against 1 to 3 EDH Top 16 reference lists for the same commander, generate a strict AI prompt, and paste the returned <code>meta_gap</code> JSON back here for a readable upgrade path.</p>
</section>

@await Html.PartialAsync("_BusyIndicator")
@await Html.PartialAsync("_DeckToolTabs", Model.ActiveTab)

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="error-banner" role="alert">@Model.ErrorMessage</div>
}

<div class="info-banner">
    Step 1 fetches EDH Top 16 reference decks, Step 2 generates the prompt from 1 to 3 selected lists, and Step 3 renders the returned <code>meta_gap</code> JSON.
</div>

<div class="error-banner hidden" data-prompt-cedh-validation-error role="alert"></div>

<form method="post" action="@Url.Content("~/cedh-meta-gap")" class="deck-form" data-print-region="workflow" data-cache-key="prompt-cedh-meta-gap" data-prompt-cedh-form data-prompt-cedh-current-step="@currentStep" data-busy-title="Building cEDH Meta Gap Packet" data-busy-message="Parsing your deck, querying EDH Top 16, and generating the prompt.">
    <div class="prompt-sticky-download" role="region" aria-label="Save current session">
        <span class="prompt-sticky-download__label">Save your work in progress to a zip file you can re-import later.</span>
        <button type="submit" class="run-button prompt-sticky-download__button" data-no-busy data-prompt-download-submit
                formaction="@Url.Content("~/cedh-meta-gap/download")"
                formmethod="post"
                formnovalidate>
            Download meta-gap session (.zip)
        </button>
    </div>
    @Html.AntiForgeryToken()
    <input type="hidden" name="WorkflowStep" value="@currentStep" data-prompt-cedh-workflow-step />
    <input type="hidden" name="FetchedEntriesJson" value="@Model.Request.FetchedEntriesJson" />
    <input type="hidden" name="MetaGapPromptText" value="@Model.PromptText" />
    <details class="prompt-resume" data-prompt-resume>
        <summary>Resume from a saved session (.zip)</summary>
        <p class="sync-column__hint">
            Choose a <code>.zip</code> file you previously downloaded from Step 3.
            This rehydrates the response JSON and jumps back to the meta-gap results step.
        </p>
        <label class="field">
            <span>Saved session file</span>
            <input type="file" name="zipFile" accept=".zip,application/zip"
                   data-prompt-zip-upload
                   data-upload-action="@Url.Content("~/cedh-meta-gap/upload")" />
        </label>
        <button type="submit"
                class="run-button"
                data-prompt-upload-submit
                formaction="@Url.Content("~/cedh-meta-gap/upload")"
                formenctype="multipart/form-data"
                formmethod="post"
                formnovalidate>
            Upload &amp; Resume
        </button>
    </details>

    @{
        var cedhTabs = new DeckFlow.Web.Models.WorkflowStepTabsModel(
            AriaLabel: "cEDH meta-gap workflow steps",
            TabIdPrefix: "prompt-cedh-step-tab",
            PanelIdPrefix: "prompt-cedh-step-panel",
            DataShowStepAttribute: "prompt-cedh-show-step",
            Steps: new[]
            {
                new DeckFlow.Web.Models.WorkflowStepTab(1, "Step 1: Fetch Reference Decks", Model.FetchedEntries.Count > 0 || !string.IsNullOrWhiteSpace(Model.ResolvedCommanderName)),
                new DeckFlow.Web.Models.WorkflowStepTab(2, "Step 2: Build Meta Gap Prompt", !string.IsNullOrWhiteSpace(Model.PromptText)),
                new DeckFlow.Web.Models.WorkflowStepTab(3, "Step 3: Meta Gap Results", Model.AnalysisResponse is not null)
            });
    }
    @await Html.PartialAsync("_WorkflowStepTabs", cedhTabs)

    <section class="result-panel prompt-step-panel" role="tabpanel" id="prompt-cedh-step-panel-1" aria-labelledby="prompt-cedh-step-tab-1" data-prompt-cedh-step="1">
        <div class="prompt-step-heading">
            <div>
                <p class="prompt-step-eyebrow">Step 1</p>
                <h2>Load your deck and fetch reference lists</h2>
                <p>Paste your deck URL or deck export, optionally override the commander name, then pull the top tournament lists for that commander from EDH Top 16.</p>
            </div>
        </div>

        <div class="sync-columns">
            <section class="sync-column sync-column--moxfield">
                <div class="sync-column__header">
                    <p>Your Deck</p>
                    <span class="sync-column__status">Required</span>
                </div>

                <label class="field">
                    <span>Commander name <small>(optional override)</small></span>
                    <input type="text"
                           name="CommanderName"
                           value="@Model.Request.CommanderName"
                           placeholder="Start typing a commander name…"
                           autocomplete="off"
                           list="cedh-commander-suggestions"
                           data-commander-search="@Url.Content("~/cedh-meta-gap/commander-search")" />
                    <datalist id="cedh-commander-suggestions"></datalist>
                    <small class="sync-column__hint">Leave blank to infer the commander from the submitted deck list, or pick a suggestion to match the exact EDH Top 16 name.</small>
                </label>

                @{
                    var metaIsUrl = Model.Request.DeckInputSource == DeckFlow.Web.Models.DeckInputSource.PublicUrl;
                }
                <label class="field">
                    <span>Import method</span>
                    <select name="DeckInputSource" data-df-select>
                        <option value="@DeckFlow.Web.Models.DeckInputSource.PublicUrl" selected="@(metaIsUrl ? "selected" : null)">Use public deck URL</option>
                        <option value="@DeckFlow.Web.Models.DeckInputSource.PasteText" selected="@(!metaIsUrl ? "selected" : null)">Paste text</option>
                    </select>
                </label>
                <label class="field @(metaIsUrl ? string.Empty : "hidden")" data-sync-panel="metagap-deck-url">
                    <span>Archidekt or Moxfield deck URL</span>
                    <input type="url"
                           name="DeckUrl"
                           value="@Model.Request.DeckUrl"
                           autocomplete="url"
                           inputmode="url"
                           placeholder="https://moxfield.com/decks/… or https://archidekt.com/decks/…" />
                </label>
                <label class="field @(metaIsUrl ? "hidden" : string.Empty)" data-sync-panel="metagap-deck-text">
                    <span>Deck export text</span>
                    <textarea autocomplete="off" name="DeckText" spellcheck="false">@Model.Request.DeckText</textarea>
                    <small class="sync-column__hint">Paste Moxfield, Archidekt, or MTG Arena deck export text.</small>
                </label>
                @await Html.PartialAsync("_DeckFlowBridgeHint")
                @await Html.PartialAsync("_MoxfieldBulkEditHint", "Run Gap Analysis")
            </section>

            <section class="sync-column sync-column--archidekt">
                <div class="sync-column__header">
                    <p>EDH Top 16 Filters</p>
                    <span class="sync-column__status">Required</span>
                </div>

                <label class="field">
                    <span>Time period</span>
                    <select name="TimePeriod" data-df-select>
                        @foreach (var option in Enum.GetValues<DeckFlow.Web.Models.CedhMetaTimePeriod>())
                        {
                            <option value="@option" selected="@(Model.Request.TimePeriod == option)">@FormatTimePeriodLabel(option)</option>
                        }
                    </select>
                </label>

                <label class="field">
                    <span>Sort by</span>
                    <select name="SortBy" data-df-select>
                        <option value="TOP" selected="@(Model.Request.SortBy == DeckFlow.Web.Models.CedhMetaSortBy.TOP)">Top Performing</option>
                        <option value="NEW" selected="@(Model.Request.SortBy == DeckFlow.Web.Models.CedhMetaSortBy.NEW)">Recent</option>
                    </select>
                </label>

                <label class="field">
                    <span>Minimum event size</span>
                    <select name="MinEventSize" data-df-select>
                        @foreach (var sizeOption in new[] { (0, "All Events"), (16, "16+ Players"), (30, "30+ Players"), (50, "50+ Players"), (100, "100+ Players"), (250, "250+ Players") })
                        {
                            <option value="@sizeOption.Item1" selected="@(Model.Request.MinEventSize == sizeOption.Item1)">@sizeOption.Item2</option>
                        }
                    </select>
                </label>

                <label class="field">
                    <span>Maximum standing</span>
                    <select name="MaxStanding" data-df-select>
                        @foreach (var standingOption in new[] { ((int?)null, "All Players"), ((int?)16, "Top 16"), ((int?)4, "Top 4"), ((int?)1, "Winner") })
                        {
                            <option value="@(standingOption.Item1?.ToString() ?? string.Empty)" selected="@(Model.Request.MaxStanding == standingOption.Item1)">@standingOption.Item2</option>
                        }
                    </select>
                </label>
            </section>
        </div>

        <div class="prompt-step-footer">
            <button type="button" class="clear-cache-button" data-clear-cache data-clear-href="@Url.Content("~/cedh-meta-gap")">Start Over</button>
            <button type="submit" class="run-button" data-prompt-cedh-submit-step="1" data-default-action>Fetch Top Decks</button>
        </div>
    </section>

    <section class="result-panel prompt-step-panel" role="tabpanel" id="prompt-cedh-step-panel-2" aria-labelledby="prompt-cedh-step-tab-2" data-prompt-cedh-step="2">
        <div class="prompt-step-heading">
            <div>
                <p class="prompt-step-eyebrow">Step 2</p>
                <h2>Select 1 to 3 reference decks and generate the prompt</h2>
                <p>Choose 1 to 3 EDH Top 16 entries, build the prompt, then paste it into your AI and request a readable response followed by the fenced <code>meta_gap</code> JSON block.</p>
            </div>
        </div>
        @await Html.PartialAsync("_AiSelector", Model.Request.TargetAiPlatform)

        @if (!string.IsNullOrWhiteSpace(Model.ResolvedCommanderName))
        {
            <div class="info-banner">
                Resolved commander for EDH Top 16 lookup: <strong>@Model.ResolvedCommanderName</strong>
            </div>
        }

        @if (Model.FetchedEntries.Count > 0)
        {
            <section class="result-panel nested-panel">
                <div class="panel-heading">
                    <div>
                        <h3>EDH Top 16 References</h3>
                        <p>@(Model.Request.SortBy == DeckFlow.Web.Models.CedhMetaSortBy.TOP ? "Sorted by top performance first." : "Sorted by newest tournament first.") Select 1 to 3 decks; click a column heading to re-sort. The client enforces the limit before submit.</p>
                    </div>
                </div>

                @* Mobile-only sort control: the column-header sort buttons live in
                   <thead>, which is sr-only-hidden at <=600px, so phones get this
                   visible equivalent wired to the same client-side sort. *@
                <div class="cedh-mobile-sort" data-prompt-cedh-mobile-sort>
                    <label class="field cedh-mobile-sort__field">
                        <span>Sort by</span>
                        <select data-prompt-cedh-mobile-sort-select>
                            <option value="" selected>Tournament order</option>
                            <option value="2" data-sort-type="text">Player</option>
                            <option value="3" data-sort-type="text">Date</option>
                            <option value="4" data-sort-type="num">Participants</option>
                            <option value="5" data-sort-type="num">Finish</option>
                            <option value="7" data-sort-type="num">Win %</option>
                        </select>
                    </label>
                    <button type="button" class="clear-cache-button cedh-mobile-sort__dir"
                            data-prompt-cedh-mobile-sort-dir data-direction="ascending"
                            aria-label="Sort ascending">Asc &#9650;</button>
                </div>

                @* tabindex+role make the horizontal scroll container keyboard-reachable; the
                   9-column table overflows between 601px and desktop. *@
                <div class="table-wrapper" tabindex="0" role="region" aria-label="EDH Top 16 reference decks (scrollable)">
                    @* role=* attributes restore table semantics that the <=600px display:grid
                       override would otherwise strip from screen readers (Roselli 2017).
                       Sortable headers use an in-cell <button> + aria-sort; deck-sync.ts
                       re-sorts + re-paginates client-side. *@
                    <table class="conflicts-table" data-prompt-cedh-reference-table role="table" data-prompt-cedh-page-size="@pageSize">
                        <caption class="sr-only">EDH Top 16 reference decks for the resolved commander. Use the column heading buttons to sort.</caption>
                        <thead role="rowgroup">
                        <tr role="row">
                            <th scope="col" role="columnheader">Select</th>
                            <th scope="col" class="tabular" role="columnheader">#</th>
                            <th scope="col" role="columnheader" aria-sort="none">
                                <button type="button" class="cedh-sort-button" data-prompt-cedh-sort data-prompt-cedh-sort-type="text">Player<span class="cedh-sort-indicator" aria-hidden="true"></span></button>
                            </th>
                            <th scope="col" role="columnheader" aria-sort="none">
                                <button type="button" class="cedh-sort-button" data-prompt-cedh-sort data-prompt-cedh-sort-type="text">Date<span class="cedh-sort-indicator" aria-hidden="true"></span></button>
                            </th>
                            <th scope="col" class="tabular" role="columnheader" aria-sort="none">
                                <button type="button" class="cedh-sort-button" data-prompt-cedh-sort data-prompt-cedh-sort-type="num">Participants<span class="cedh-sort-indicator" aria-hidden="true"></span></button>
                            </th>
                            <th scope="col" role="columnheader" aria-sort="none">
                                <button type="button" class="cedh-sort-button" data-prompt-cedh-sort data-prompt-cedh-sort-type="num">Finish<span class="cedh-sort-indicator" aria-hidden="true"></span></button>
                            </th>
                            <th scope="col" class="tabular" role="columnheader">W-L-D</th>
                            <th scope="col" class="tabular" role="columnheader" aria-sort="none">
                                <button type="button" class="cedh-sort-button" data-prompt-cedh-sort data-prompt-cedh-sort-type="num">Win %<span class="cedh-sort-indicator" aria-hidden="true"></span></button>
                            </th>
                            <th scope="col" role="columnheader">Decklist</th>
                        </tr>
                        </thead>
                        <tbody role="rowgroup">
                        @for (var index = 0; index < Model.FetchedEntries.Count; index++)
                        {
                            var entry = Model.FetchedEntries[index];
                            var rowPage = (index / pageSize) + 1;
                            <tr role="row" data-prompt-cedh-reference-row data-prompt-cedh-page="@rowPage">
                                <td role="cell" data-label="Select">
                                    <input type="checkbox"
                                           name="SelectedReferenceIndexes"
                                           value="@index"
                                           aria-label="Select reference deck #@(index + 1)@(string.IsNullOrWhiteSpace(entry.PlayerName) ? "" : $" — {entry.PlayerName}")"
                                           checked="@(selectedReferenceIndexes.Contains(index) ? "checked" : null)"
                                           data-prompt-cedh-reference-checkbox />
                                </td>
                                <td class="tabular" role="cell" data-label="#" data-sort-value="@(index + 1)">@(index + 1)</td>
                                <td role="cell" data-label="Player" data-sort-value="@(string.IsNullOrWhiteSpace(entry.PlayerName) ? "Unknown" : entry.PlayerName)">@(string.IsNullOrWhiteSpace(entry.PlayerName) ? "Unknown" : entry.PlayerName)</td>
                                <td role="cell" data-label="Date" data-sort-value="@(entry.TournamentDate?.ToString("yyyy-MM-dd") ?? "")">@(entry.TournamentDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                <td class="tabular" role="cell" data-label="Participants" data-sort-value="@(entry.TournamentSize > 0 ? entry.TournamentSize : 0)">@(entry.TournamentSize > 0 ? entry.TournamentSize : 0)</td>
                                <td role="cell" data-label="Finish" data-sort-value="@entry.Standing">@entry.Standing</td>
                                <td class="tabular" role="cell" data-label="W-L-D">@entry.Wins-@entry.Losses-@entry.Draws</td>
                                <td class="tabular" role="cell" data-label="Win %" data-sort-value="@entry.WinRate.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)">@entry.WinRate.ToString("P0")</td>
                                <td role="cell" data-label="Decklist">
                                    @if (!string.IsNullOrWhiteSpace(entry.DecklistUrl))
                                    {
                                        <a href="@entry.DecklistUrl" target="_blank" rel="noopener noreferrer">Open</a>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                @if (Model.FetchedEntries.Count > pageSize)
                {
                    var pageCount = (int)Math.Ceiling(Model.FetchedEntries.Count / (double)pageSize);
                    <div class="toolbar prompt-step-actions" data-prompt-cedh-pagination>
                        <button type="button" class="clear-cache-button" data-prompt-cedh-page-nav="prev">Previous</button>
                        <span data-prompt-cedh-page-status>Page 1 of @pageCount</span>
                        <button type="button" class="run-button" data-prompt-cedh-page-nav="next">Next</button>
                    </div>
                }
            </section>
        }

        <div class="prompt-instructions">
            <strong>What you do:</strong>
            <ol>
                <li>Select 1 to 3 reference decks.</li>
                <li>Click <code>Generate Meta Gap Prompt</code>.</li>
                <li>Copy <code>30-meta-gap-prompt.txt</code>.</li>
                <li>Paste it into your AI.</li>
                <li>Have your AI respond with a readable meta-gap summary first, then a fenced <code>```json</code> block whose top-level object is <code>meta_gap</code>.</li>
                <li>Paste that JSON into Step 3.</li>
            </ol>
        </div>

        <div class="toolbar prompt-step-actions">
            <button type="submit" class="run-button" data-prompt-cedh-submit-step="2" data-default-action>Generate Meta Gap Prompt</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.PromptText))
        {
            <details class="result-panel nested-panel" data-prompt-cedh-result-anchor>
                <summary>Show generated prompt (30-meta-gap-prompt.txt)</summary>
                <div class="panel-heading">
                    <div>
                        <h3>30-meta-gap-prompt.txt</h3>
                        <p>Paste this into @aiPlatform.DisplayName to get a readable meta-gap summary followed by the final <code>meta_gap</code> JSON.</p>
                    </div>
                    <button type="button" class="copy-button" data-copy-target="cedh-meta-gap-prompt-output">Copy</button>
                </div>
                <textarea autocomplete="off" id="cedh-meta-gap-prompt-output" readonly spellcheck="false">@Model.PromptText</textarea>
                @await Html.PartialAsync("_PromptSplitTip", "meta_gap")
            </details>
        }

        @if (!string.IsNullOrWhiteSpace(Model.SchemaJson))
        {
            <details class="result-panel nested-panel">
                <summary>Show expected JSON format</summary>
                <div class="panel-heading">
                    <div>
                        <h3>31-meta-gap-schema.json</h3>
                        <p>@aiPlatform.DisplayName should return a top-level <code>meta_gap</code> object matching this shape.</p>
                    </div>
                    <button type="button" class="copy-button" data-copy-target="cedh-meta-gap-schema-output">Copy</button>
                </div>
                <textarea autocomplete="off" id="cedh-meta-gap-schema-output" readonly spellcheck="false">@Model.SchemaJson</textarea>
            </details>
        }

        <div class="prompt-step-footer">
            <button type="button" class="clear-cache-button" data-prompt-cedh-show-step="1">Back: Fetch Decks</button>
            <button type="button" class="run-button" data-prompt-cedh-next-step="3">Next: Paste JSON</button>
        </div>
    </section>

    <section class="result-panel prompt-step-panel" role="tabpanel" id="prompt-cedh-step-panel-3" aria-labelledby="prompt-cedh-step-tab-3" data-prompt-cedh-step="3">
        <div class="prompt-step-heading">
            <div>
                <p class="prompt-step-eyebrow">Step 3</p>
                <h2>Paste the returned meta-gap JSON</h2>
                <p>Paste the fenced JSON block or raw JSON payload that contains the top-level <code>meta_gap</code> object. Extra prose above it is fine.</p>
            </div>
        </div>

        <label class="field">
            <span>Meta gap JSON</span>
            <textarea autocomplete="off" name="MetaGapResponseJson" spellcheck="false">@Model.Request.MetaGapResponseJson</textarea>
            <small class="sync-column__hint">Required for rendering the final analysis. You can paste the fenced <code>```json</code> block directly.</small>
        </label>

        <div class="toolbar prompt-step-actions">
            <button type="submit" class="run-button" data-prompt-cedh-submit-step="3" data-default-action data-busy-title="Rendering cEDH Meta Gap Analysis" data-busy-message="Reading your pasted analysis and building the report.">Render Meta Gap Analysis</button>
        </div>

        @if (Model.AnalysisResponse is not null)
        {
            var analysis = Model.AnalysisResponse.MetaGap;
            <section class="result-panel nested-panel summary-panel" data-prompt-cedh-result-anchor data-print-result>
                <div class="toolbar prompt-step-actions">
                    <button type="submit" class="run-button" data-no-busy data-prompt-download-submit
                            formaction="@Url.Content("~/cedh-meta-gap/download")"
                            formmethod="post"
                            formnovalidate>
                        Download meta-gap session (.zip)
                    </button>
                    <button type="button" class="run-button prompt-print-button" data-no-busy data-prompt-print>
                        Print results
                    </button>
                </div>
                <h3>Meta Gap Analysis</h3>
                <div class="stack">
                    <section class="result-panel nested-panel">
                        <h4>Overview</h4>
                        <p><strong>Commander:</strong> @analysis.Commander</p>
                        <p><strong>Reference decks:</strong> @analysis.RefDeckCount</p>
                        @if (!string.IsNullOrWhiteSpace(analysis.ColorId))
                        {
                            <p><strong>Color identity:</strong> @analysis.ColorId</p>
                        }
                        @if (analysis.ReadinessScore > 0)
                        {
                            <p><strong>cEDH Readiness:</strong> @analysis.ReadinessScore / 10</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(analysis.ReadinessJustification))
                        {
                            <p><strong>Readiness call:</strong> @analysis.ReadinessJustification</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(analysis.MetaSummary))
                        {
                            <p><strong>Meta positioning:</strong> @analysis.MetaSummary</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(analysis.OptimizationPath))
                        {
                            <p><strong>Upgrade path:</strong> @analysis.OptimizationPath</p>
                        }
                    </section>

                    <div class="sync-columns">
                        @if (analysis.WinLines is not null)
                        {
                            <section class="result-panel nested-panel">
                                <h4>Win Lines</h4>
                                <ul>
                                    @if (analysis.WinLines.MyDeck is not null && !string.IsNullOrWhiteSpace(analysis.WinLines.MyDeck.Primary))
                                    {
                                        <li><strong>Your primary line:</strong> @analysis.WinLines.MyDeck.Primary</li>
                                    }
                                    @if (analysis.WinLines.MyDeck is not null && !string.IsNullOrWhiteSpace(analysis.WinLines.MyDeck.Backup))
                                    {
                                        <li><strong>Your backup line:</strong> @analysis.WinLines.MyDeck.Backup</li>
                                    }
                                    @if (analysis.WinLines.RefConsensus is not null && !string.IsNullOrWhiteSpace(analysis.WinLines.RefConsensus.Primary))
                                    {
                                        <li><strong>Meta primary line:</strong> @analysis.WinLines.RefConsensus.Primary</li>
                                    }
                                    @if (analysis.WinLines.RefConsensus is not null && !string.IsNullOrWhiteSpace(analysis.WinLines.RefConsensus.Backup))
                                    {
                                        <li><strong>Meta backup line:</strong> @analysis.WinLines.RefConsensus.Backup</li>
                                    }
                                    @foreach (var missingLine in analysis.WinLines.MissingLines.Where(line => !string.IsNullOrWhiteSpace(line)))
                                    {
                                        <li><strong>Missing line:</strong> @missingLine</li>
                                    }
                                </ul>
                            </section>
                        }

                        @if (analysis.Interaction is not null)
                        {
                            <section class="result-panel nested-panel">
                                <h4>Interaction</h4>
                                <p><strong>Your interaction count:</strong> @analysis.Interaction.MyCount</p>
                                <p><strong>Reference average:</strong> @analysis.Interaction.RefAvgCount.ToString("F1")</p>
                                @if (!string.IsNullOrWhiteSpace(analysis.Interaction.Verdict))
                                {
                                    <p><strong>Verdict:</strong> @analysis.Interaction.Verdict</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(analysis.Interaction.Detail))
                                {
                                    <p>@analysis.Interaction.Detail</p>
                                }
                            </section>
                        }
                    </div>

                    <div class="sync-columns">
                        @if (analysis.Speed is not null)
                        {
                            <section class="result-panel nested-panel">
                                <h4>Speed</h4>
                                @if (!string.IsNullOrWhiteSpace(analysis.Speed.MyClassification) || !string.IsNullOrWhiteSpace(analysis.Speed.MyAvgTurn))
                                {
                                    <p><strong>Your deck:</strong> @analysis.Speed.MyClassification@if (!string.IsNullOrWhiteSpace(analysis.Speed.MyAvgTurn))
                                        {
                                            <text> (@analysis.Speed.MyAvgTurn)</text>
                                        }
                                    </p>
                                }
                                @if (!string.IsNullOrWhiteSpace(analysis.Speed.RefClassification) || !string.IsNullOrWhiteSpace(analysis.Speed.RefAvgTurn))
                                {
                                    <p><strong>Reference field:</strong> @analysis.Speed.RefClassification@if (!string.IsNullOrWhiteSpace(analysis.Speed.RefAvgTurn))
                                        {
                                            <text> (@analysis.Speed.RefAvgTurn)</text>
                                        }
                                    </p>
                                }
                                @if (!string.IsNullOrWhiteSpace(analysis.Speed.Detail))
                                {
                                    <p>@analysis.Speed.Detail</p>
                                }
                            </section>
                        }

                        @if (analysis.ManaEfficiency is not null)
                        {
                            <section class="result-panel nested-panel">
                                <h4>Mana Efficiency</h4>
                                <p><strong>Fast mana:</strong> @analysis.ManaEfficiency.MyFastMana vs meta @analysis.ManaEfficiency.RefAvgFastMana.ToString("F1")</p>
                                <p><strong>Average CMC:</strong> @analysis.ManaEfficiency.MyAvgCmc.ToString("F2") vs meta @analysis.ManaEfficiency.RefAvgCmc.ToString("F2")</p>
                                <p><strong>Lands:</strong> @analysis.ManaEfficiency.MyLands vs meta @analysis.ManaEfficiency.RefAvgLands.ToString("F1")</p>
                                @if (!string.IsNullOrWhiteSpace(analysis.ManaEfficiency.Detail))
                                {
                                    <p>@analysis.ManaEfficiency.Detail</p>
                                }
                            </section>
                        }
                    </div>

                    @if (analysis.CoreConvergence.Count > 0)
                    {
                        <section class="result-panel nested-panel">
                            <h4>Core Convergence</h4>
                            <ul>
                                @foreach (var item in analysis.CoreConvergence.Where(item => !string.IsNullOrWhiteSpace(item.Card)))
                                {
                                    <li>
                                        <strong>@item.Card</strong>
                                        @if (!string.IsNullOrWhiteSpace(item.Role))
                                        {
                                            <text> (@item.Role)</text>
                                        }
                                        : @(item.InMyDeck ? "already in your deck" : "missing from your deck")
                                    </li>
                                }
                            </ul>
                        </section>
                    }

                    <div class="sync-columns">
                        @if (analysis.MissingStaples.Count > 0)
                        {
                            <section class="result-panel nested-panel">
                                <h4>Missing Staples</h4>
                                <ul>
                                    @foreach (var item in analysis.MissingStaples.OrderBy(item => item.Priority).Where(item => !string.IsNullOrWhiteSpace(item.Card)))
                                    {
                                        <li>
                                            <strong>#@item.Priority @item.Card</strong>
                                            @if (!string.IsNullOrWhiteSpace(item.Role))
                                            {
                                                <text> (@item.Role)</text>
                                            }
                                            @if (item.RefCount > 0)
                                            {
                                                <text> seen in @item.RefCount reference deck(s)</text>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(item.Why))
                                            {
                                                <text> - @item.Why</text>
                                            }
                                        </li>
                                    }
                                </ul>
                            </section>
                        }

                        @if (analysis.PotentialCuts.Count > 0)
                        {
                            <section class="result-panel nested-panel">
                                <h4>Potential Cuts</h4>
                                <ul>
                                    @foreach (var item in analysis.PotentialCuts.OrderBy(item => item.Priority).Where(item => !string.IsNullOrWhiteSpace(item.Card)))
                                    {
                                        <li>
                                            <strong>#@item.Priority @item.Card</strong>
                                            @if (!string.IsNullOrWhiteSpace(item.Role))
                                            {
                                                <text> (@item.Role)</text>
                                            }
                                            @if (item.RefCount > 0)
                                            {
                                                <text> found in @item.RefCount reference deck(s)</text>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(item.Why))
                                            {
                                                <text> - @item.Why</text>
                                            }
                                        </li>
                                    }
                                </ul>
                            </section>
                        }
                    </div>

                    <div class="sync-columns">
                        @if (analysis.Top10Adds.Count > 0)
                        {
                            <section class="result-panel nested-panel">
                                <h4>Top 10 Adds</h4>
                                <ul>
                                    @foreach (var item in analysis.Top10Adds.Where(item => !string.IsNullOrWhiteSpace(item.Card)))
                                    {
                                        <li>
                                            <strong>@item.Card</strong>
                                            @if (!string.IsNullOrWhiteSpace(item.Replaces))
                                            {
                                                <text> in for <strong>@item.Replaces</strong></text>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(item.Role))
                                            {
                                                <text> (@item.Role)</text>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(item.Why))
                                            {
                                                <text> - @item.Why</text>
                                            }
                                        </li>
                                    }
                                </ul>
                            </section>
                        }

                        @if (analysis.Top10Cuts.Count > 0)
                        {
                            <section class="result-panel nested-panel">
                                <h4>Top 10 Cuts</h4>
                                <ul>
                                    @foreach (var item in analysis.Top10Cuts.Where(item => !string.IsNullOrWhiteSpace(item.Card)))
                                    {
                                        <li>
                                            <strong>@item.Card</strong>
                                            @if (!string.IsNullOrWhiteSpace(item.Role))
                                            {
                                                <text> (@item.Role)</text>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(item.Why))
                                            {
                                                <text> - @item.Why</text>
                                            }
                                        </li>
                                    }
                                </ul>
                            </section>
                        }
                    </div>
                </div>
            </section>
        }

        <div class="prompt-step-footer">
            <button type="button" class="clear-cache-button" data-prompt-cedh-show-step="2">Back: Generate Prompt</button>
        </div>
    </section>
</form>

@section Scripts {
    <script src="~/js/deck-input-store.js" asp-append-version="true"></script>
    <script src="~/js/busy-indicator.js" asp-append-version="true"></script>
    <script src="~/js/moxfield-extension-bridge.js" asp-append-version="true"></script>
    <script src="~/js/deck-sync.js" asp-append-version="true"></script>
}
