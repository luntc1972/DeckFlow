@model IReadOnlyList<DeckFlow.Web.Services.Harvest.HarvestRunRow>
@using DeckFlow.Web.Services.Harvest
@{
    const int ErrorMessageTruncationLength = 80;

    static string GetRunStateBadgeClass(HarvestRunState state) => state switch
    {
        HarvestRunState.Succeeded => "admin-badge admin-badge--success",
        HarvestRunState.Failed => "admin-badge admin-badge--danger",
        HarvestRunState.Interrupted => "admin-badge admin-badge--neutral",
        HarvestRunState.Cancelled => "admin-badge admin-badge--warning",
        HarvestRunState.Running => "admin-badge admin-badge--info",
        HarvestRunState.Stopping => "admin-badge admin-badge--warning",
        _ => "admin-badge admin-badge--neutral"
    };

    static (string Summary, string Body)? GetErrorDisclosure(string? errorMessage)
        => errorMessage is { Length: > ErrorMessageTruncationLength }
            ? (errorMessage[..ErrorMessageTruncationLength] + "…", errorMessage)
            : null;

    static string? GetUpdateCounters(HarvestRunRow run)
        => run.PagesPolled is int pagesPolled
            && run.RefreshesRequeued is int refreshesRequeued
            && run.RefreshesDrained is int refreshesDrained
            && run.NewIdsSeen is int newIdsSeen
            ? $"Pages {pagesPolled}, requeued {refreshesRequeued}, drained {refreshesDrained}, new IDs {newIdsSeen}"
            : null;
}

<h3 id="harvest-run-log-heading">Run Log</h3>
@if (Model.Count == 0)
{
    <p id="harvest-run-log-empty" class="admin-empty">No runs recorded yet.</p>
}
else
{
    <div id="harvest-run-log" class="admin-table-scroll" role="region" aria-label="Harvest run log - scroll horizontally to see all columns" tabindex="0">
        <table class="admin-table">
            <caption class="sr-only">Harvest run log with timing, kind, trigger, state, deck counts, update counters, and any error message</caption>
            <thead>
                <tr>
                    <th scope="col">Started</th>
                    <th scope="col">Kind</th>
                    <th scope="col">Trigger</th>
                    <th scope="col">State</th>
                    <th scope="col">Decks</th>
                    <th scope="col">Update counters</th>
                    <th scope="col">Duration</th>
                    <th scope="col">Error</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var run in Model)
                {
                    var errorDisclosure = GetErrorDisclosure(run.ErrorMessage);
                    <tr>
                        @{ var startedUtc = run.StartedUtc ?? run.RequestedUtc; }
                        <td title="@startedUtc.ToString("u")">@MountainTimeFormatter.Format(startedUtc)</td>
                        <td>@run.Kind</td>
                        <td>@(run.TriggerSource?.ToString() ?? "—")</td>
                        <td><span class="@GetRunStateBadgeClass(run.State)">@run.State</span></td>
                        <td>@run.DecksProcessed</td>
                        <td>@(GetUpdateCounters(run) ?? "—")</td>
                        <td>@run.DurationSeconds</td>
                        <td>
                            @if (errorDisclosure is not null)
                            {
                                <details class="admin-harvest__run-error">
                                    <summary>@errorDisclosure.Value.Summary</summary>
                                    <div>@errorDisclosure.Value.Body</div>
                                </details>
                            }
                            else
                            {
                                @(run.ErrorMessage ?? "—")
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
