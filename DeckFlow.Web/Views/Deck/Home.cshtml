@using DeckFlow.Web.Services.Tools
@using DeckFlow.Web.Configuration
@using Microsoft.Extensions.Options
@model DeckFlow.Web.Models.DeckPageTab
@inject DeckFlow.Web.Services.FeatureFlags.IFeatureFlagCache FlagCache
@inject DeckFlow.Web.Services.Tools.IToolRegistry ToolRegistry
@inject IOptions<AiPlatformOptions> AiPlatformOptionsAccessor
@{
    ViewData["Title"] = "MTG Deck Analysis Tools for Commander & cEDH";
    ViewData["Description"] = "Free Magic: The Gathering deck tools for Commander and cEDH. Manabase math, bracket check, meta gap, and deck history — with optional one-paste AI prompt export.";
    var sections = ToolVisibility.VisibleBySection(ToolRegistry.All, FlagCache);
    var platformList = AiPlatformCopy.PlatformList(AiPlatformOptionsAccessor.Value.GeminiEnabled);
    var headlineWorkflow = sections
        .SelectMany(section => section.Tools)
        .FirstOrDefault(tool => tool.Key == "deck-analysis");
}

@await Html.PartialAsync("_DeckToolTabs", Model)

<p class="hub-lede">Personal Magic: The Gathering deck tooling — analysis, sync, reference, and categories.</p>

@if (headlineWorkflow is not null)
{
    <a class="hub-hero hub-hero--primary" href="@Url.Content("~" + headlineWorkflow.Route)">
        <span class="hub-hero__eyebrow">Headline workflow</span>
        <span class="hub-hero__title">Analyze Your Deck</span>
        <span class="hub-hero__description">Five-step workflow: load your deck, pick your questions, and get back a structured review — one paste, one round-trip.</span>
    </a>
}

@foreach (var section in sections)
{
    var sectionName = section.Section.ToString();
    var sectionId = $"hub-group-{sectionName.ToLowerInvariant()}";

    <section class="hub-group" aria-labelledby="@sectionId">
        <h2 id="@sectionId" class="hub-group__title">
            <span class="hub-group__icon">
                @switch (section.Section)
                {
                    case ToolNavSection.Analyze:
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="7" cy="7" r="4.5"/><line x1="10.5" y1="10.5" x2="14" y2="14"/></svg>
                        break;
                    case ToolNavSection.Build:
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8a5 5 0 0 1 9.9-1M13 8a5 5 0 0 1-9.9 1"/><polyline points="11,5 13,7 11,9"/><polyline points="5,11 3,9 5,7"/></svg>
                        break;
                    case ToolNavSection.Reference:
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="7" cy="7" r="4.5"/><line x1="10.5" y1="10.5" x2="14" y2="14"/></svg>
                        break;
                    case ToolNavSection.Categories:
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 4h5l1.5 2H14v7H2z"/></svg>
                        break;
                }
            </span>
            @sectionName
        </h2>
        <div class="hub-grid">
            @foreach (var tool in section.Tools)
            {
                <a class="hub-card @(tool.IsPrimaryTile ? "hub-card--primary" : string.Empty)" href="@Url.Content("~" + tool.Route)">
                    <span class="hub-card__icon">
                        @await Html.PartialAsync("_ToolTileIcon", tool.IconKey)
                    </span>
                    <h3 class="hub-card__title">@tool.TileTitle</h3>
                    <p class="hub-card__description">@tool.TileDescription</p>
                </a>
            }
        </div>
    </section>
}
