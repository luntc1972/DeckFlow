<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>9b9eba2b-de02-4f06-901c-abef7d2719d6</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeckFlow.Core\DeckFlow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Why: grants the test project access to the internal WriteRowsAsync test seam on
         DirectPush (Codex MEDIUM-1 hard-guard test); no internal surface leaks to consumers. -->
    <InternalsVisibleTo Include="DeckFlow.Studio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuses the in-solution Markdig (same 1.3.2 the web app uses) to render the review-queue
         notes preview as HTML, mirroring the public /content-kb detail page. -->
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
</Project>
