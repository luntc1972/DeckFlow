@using DeckFlow.Core.Models
@model DeckFlow.Web.Models.DeckDiffViewModel
@{
    var suggestionMode = Model.SuggestionRequest.Mode;
    var suggestionInputSource = Model.SuggestionRequest.ArchidektInputSource;
    var hasReferenceInput = suggestionMode == CategorySuggestionMode.ReferenceDeck
        && (!string.IsNullOrWhiteSpace(Model.SuggestionRequest.ArchidektUrl) || !string.IsNullOrWhiteSpace(Model.SuggestionRequest.ArchidektText));
    var cardSpecified = !string.IsNullOrWhiteSpace(Model.SuggestionRequest.CardName);
    var hasMerged = !string.IsNullOrWhiteSpace(Model.MergedCategoriesText);
    var hasWeightedCategories = Model.WeightedCategories.Count > 0;
    ViewData["Title"] = "MTG Deck Category & Tag Suggestions";
    ViewData["Description"] = "Get suggested categories and tags for every card in your Commander deck, drawn from DeckFlow's category knowledge base of public deck data. Speeds up Archidekt deck organization.";
}

<section class="hero">
    <h1>Category Suggestions</h1>
    <p class="lede">Look up a single card against the local category store and recent public Archidekt decks.</p>
</section>

@await Html.PartialAsync("_BusyIndicator")
@await Html.PartialAsync("_DeckToolTabs", Model.ActiveTab)

<div class="warning-banner">
    Suggestions are merged into one ranked category list. Cached store results are the default source, and exact Archidekt deck matches are optional.
</div>

<div class="error-banner @(string.IsNullOrWhiteSpace(Model.SuggestionErrorMessage) ? "hidden" : string.Empty)" role="alert" data-api-panel="suggest-error">
    <span data-api-field="suggest-error-text">@Model.SuggestionErrorMessage</span>
</div>

<div class="error-banner hidden" role="alert" data-api-panel="card-search-error">
    <span data-api-field="card-search-error-text"></span>
</div>

<form method="post" action="@Url.Content("~/suggest-categories")" class="deck-form" data-cache-key="suggest-categories" data-validate-lookup data-busy-title="Finding Categories" data-busy-message="Checking cached category data and optional sources." data-busy-progress="Checking cached store|Querying optional sources|Finalizing category matches" data-busy-hold-final-step="true" data-suggestions-type="card" data-suggestion-api="@Url.Content("~/api/suggestions/card")">
    @Html.AntiForgeryToken()
    <div class="toolbar">
        <label class="mode-picker">
            <span>Lookup mode</span>
            <select name="Mode" required data-default-value="@CategorySuggestionMode.All" data-df-select>
                <option value="@CategorySuggestionMode.All" selected="@(suggestionMode == CategorySuggestionMode.All ? "selected" : null)">All sources</option>
                <option value="@CategorySuggestionMode.CachedData" selected="@(suggestionMode == CategorySuggestionMode.CachedData ? "selected" : null)">Use cached data</option>
                <option value="@CategorySuggestionMode.ReferenceDeck" selected="@(suggestionMode == CategorySuggestionMode.ReferenceDeck ? "selected" : null)">Use reference deck</option>
                <option value="@CategorySuggestionMode.ScryfallTagger" selected="@(suggestionMode == CategorySuggestionMode.ScryfallTagger ? "selected" : null)">Scryfall Tagger</option>
            </select>
        </label>
        <label class="mode-picker flex-grow">
            <span>Card name</span>
            <input type="text" name="CardName" value="@Model.SuggestionRequest.CardName" placeholder="Guardian Project" autocomplete="off" required />
        </label>
        <button type="submit" class="run-button" data-enable-on-ready>Suggest</button>
        <button type="button" class="clear-cache-button" data-clear-cache data-clear-href="@Url.Content("~/suggest-categories")">Clear</button>
    </div>

    <div class="mode-note">
        <span>Cached data is the default. Switch to a reference deck only when you want exact deck-local categories from a specific Archidekt list.</span>
    </div>
    <div class="mode-note">
        <span>Cached results reflect the latest completed Archidekt harvest stored locally.</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuggestionRequest.CardName) && Model.CardDeckTotals.TotalDeckCount > 0)
    {
        <div class="info-banner">
            <p>The cached store currently contains <strong>@Model.CardDeckTotals.TotalDeckCount</strong> deck(s) featuring @Model.SuggestionRequest.CardName.</p>
        </div>
    }

    <div class="reference-controls @(suggestionMode == CategorySuggestionMode.ReferenceDeck ? string.Empty : "hidden")">
        <label class="mode-picker">
            <span>Reference deck input</span>
            <select name="ArchidektInputSource" required data-default-value="@DeckInputSource.PublicUrl" data-df-select>
                <option value="@DeckInputSource.PublicUrl" selected="@(suggestionInputSource == DeckInputSource.PublicUrl ? "selected" : null)">Use public deck URL</option>
                <option value="@DeckInputSource.PasteText" selected="@(suggestionInputSource == DeckInputSource.PasteText ? "selected" : null)">Paste text</option>
            </select>
        </label>

        <div class="url-grid @(suggestionInputSource == DeckInputSource.PublicUrl ? string.Empty : "hidden")" data-suggest-panel="url">
            <label class="field" data-suggest-panel="archidekt-url">
                <span>Archidekt public deck URL</span>
                <input type="url" name="ArchidektUrl" value="@Model.SuggestionRequest.ArchidektUrl" autocomplete="url" inputmode="url" placeholder="https://archidekt.com/decks/…" />
            </label>
        </div>

        <div class="field-grid @(suggestionInputSource == DeckInputSource.PasteText ? string.Empty : "hidden")" data-suggest-panel="text">
            <label class="field" data-suggest-panel="archidekt-text">
                <span>Archidekt export text</span>
                <textarea autocomplete="off" name="ArchidektText" spellcheck="false">@Model.SuggestionRequest.ArchidektText</textarea>
            </label>
        </div>
    </div>
</form>

<div class="info-banner @(cardSpecified ? string.Empty : "hidden")" data-api-panel="lookup-hint">
    <p data-api-field="lookup-hint-text">
        @if (!string.IsNullOrWhiteSpace(Model.NoSuggestionsMessage))
        {
            @Model.NoSuggestionsMessage
        }
        else if (cardSpecified)
        {
            <text>The cached store tracks Archidekt categories that appear on decks containing @Model.SuggestionRequest.CardName when they have been observed by a completed harvest.</text>
        }
        else
        {
            <text>Enter a card name and click Suggest to see category suggestions.</text>
        }
    </p>
</div>

<div class="info-banner @(Model.CardDeckTotals.TotalDeckCount > 0 && cardSpecified ? string.Empty : "hidden")" data-api-panel="cache-info">
    <p data-api-field="cache-info-text">The cached store currently contains <strong data-api-field="cache-info-count">@Model.CardDeckTotals.TotalDeckCount</strong> deck(s) featuring @Model.SuggestionRequest.CardName.</p>
</div>

<section class="result-panel retry-panel @(Model.NoSuggestionsFound ? string.Empty : "hidden")" data-api-panel="no-suggestions">
    <div class="panel-heading">
        <div>
            <h2>No Suggestions Found</h2>
            <p data-api-field="no-suggestions-text">@Model.NoSuggestionsMessage</p>
        </div>
        <button type="button" class="run-button" data-api-action="retry">Check Again</button>
    </div>
</section>

<section class="stack">
    <section class="result-panel summary-panel @(string.IsNullOrWhiteSpace(Model.SuggestionSourceSummary) ? "hidden" : string.Empty)" data-api-panel="source-summary">
        <strong>Source used</strong>
        <p data-api-field="source-summary-text">@Model.SuggestionSourceSummary</p>
    </section>
    <p class="manabase-lens-note">Tagger-sourced suggestions use community card tags from <a href="https://tagger.scryfall.com" target="_blank" rel="noopener noreferrer">Scryfall Tagger</a>.</p>

    <section class="result-panel @(hasMerged ? string.Empty : "hidden")" data-api-panel="merged">
        <div class="panel-heading">
            <div>
                <h2>Suggested Categories</h2>
            </div>
            <button type="button" class="copy-button" data-copy-target="merged-categories-output">Copy</button>
        </div>
        @if (hasWeightedCategories)
        {
            <table class="conflicts-table" aria-label="Weighted category suggestions">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Decks</th>
                        <th>%</th>
                        <th title="Sources that agreed / sources that contributed" aria-label="Sources that agreed / sources that contributed">Sources</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.WeightedCategories)
                    {
                        <tr>
                            <td>@row.Category</td>
                            <td>@(row.DeckCount?.ToString() ?? "—")</td>
                            <td>@(row.Percent?.ToString() ?? "—")</td>
                            <td>@row.SourceCount/@row.SourceTotal</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <textarea autocomplete="off" id="merged-categories-output" data-api-field="merged-text" readonly spellcheck="false">@Model.MergedCategoriesText</textarea>
    </section>
</section>

@section Scripts {
    <script src="~/js/busy-indicator.js" asp-append-version="true"></script>
    <script src="~/js/moxfield-extension-bridge.js" asp-append-version="true"></script>
    <script src="~/js/deck-sync.js" asp-append-version="true"></script>
    <script src="~/js/card-search.js" asp-append-version="true"></script>
    <script src="~/js/category-suggestions.js" asp-append-version="true"></script>
}
