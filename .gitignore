.vs/
bin/
obj/
artifacts/
*.user
*.suo
*.log
# Match both the directory AND a worktree junction symlink named node_modules
# (a trailing-slash pattern ignores only the dir, letting `git add -A` stage the
# symlink — which then checks out as a text file and breaks the TS build).
node_modules
AGENTS.md
DeckFlow.Web/wwwroot/extensions/*.zip
DeckFlow.Web/wwwroot/js/*.js
/.codex
docs/superpowers/
.claude/worktrees/

# Probe scratch files
*_probe.json

.gstack/
DeckFlow.Web/test-results/
DeckFlow.Web/playwright-report/
DeckFlow.Web/blob-report/
DeckFlow.Web/.playwright/

# DeckFlow.Studio local secret-capable files; appsettings.Development.json stays committed for logging-only config
DeckFlow.Studio/appsettings*.local.json
DeckFlow.Studio/appsettings.Local.json
DeckFlow.Studio/secrets.json

# Manabase baseline harness local artifacts (the gating sentinel + harvested decks).
# The live-Scryfall regenerator is gated by .manabase-harness-on (kept uncommitted), so ignoring
# the sentinel is what keeps CI from hitting Scryfall. The *-facts.json caches, by contrast, are
# offline fixtures consumed by the unconditional health-band regression tests and MUST be tracked.
.manabase-*.json
!.manabase-*-facts.json
.manabase-harness-on
archidekt-baseline-decks.json
