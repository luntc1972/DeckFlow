@using DeckFlow.Web.Models
@model DeckPageTab
@inject DeckFlow.Web.Services.FeatureFlags.IFeatureFlagCache FlagCache

@{
    var analyzeActive = Model is DeckPageTab.DeckAnalysis or DeckPageTab.DeckComparison or DeckPageTab.CedhMetaGap or DeckPageTab.Manabase;
    var buildActive = Model is DeckPageTab.Sync or DeckPageTab.Convert or DeckPageTab.DeckPrimer;
    var referenceActive = Model is DeckPageTab.CardLookup or DeckPageTab.MechanicLookup or DeckPageTab.JudgeQuestions or DeckPageTab.ContentKb;
    var categoriesActive = Model is DeckPageTab.SuggestCategories or DeckPageTab.CommanderCategories;
}

<nav id="deck-tool-nav" class="tool-nav" aria-label="Deck tools" data-tool-nav>
    <button type="button" class="tool-nav__menu-toggle" data-tool-nav-menu-toggle aria-expanded="false" aria-controls="deck-tool-nav" hidden>Tools</button>
    <div class="tool-nav__group @(analyzeActive ? "is-active" : string.Empty)" data-tool-nav-group>
        <button type="button" class="tool-nav__trigger" aria-expanded="false" aria-haspopup="true" data-tool-nav-trigger>
            Analyze
        </button>
        <div class="tool-nav__dropdown">
            <a class="tool-nav__link @(Model == DeckPageTab.DeckAnalysis ? "is-active" : string.Empty)" href="@Url.Content("~/deck-analysis")">Deck Analysis</a>
            <a class="tool-nav__link @(Model == DeckPageTab.DeckComparison ? "is-active" : string.Empty)" href="@Url.Content("~/deck-comparison")">Deck Comparison</a>
            <a class="tool-nav__link @(Model == DeckPageTab.CedhMetaGap ? "is-active" : string.Empty)" href="@Url.Content("~/cedh-meta-gap")">cEDH Meta Gap</a>
            <a class="tool-nav__link @(Model == DeckPageTab.Manabase ? "is-active" : string.Empty)" href="@Url.Content("~/manabase")">Mana Base</a>
        </div>
    </div>
    <div class="tool-nav__group @(buildActive ? "is-active" : string.Empty)" data-tool-nav-group>
        <button type="button" class="tool-nav__trigger" aria-expanded="false" aria-haspopup="true" data-tool-nav-trigger>
            Build
        </button>
        <div class="tool-nav__dropdown">
            <a class="tool-nav__link @(Model == DeckPageTab.Sync ? "is-active" : string.Empty)" href="@Url.Content("~/sync")">Deck Sync</a>
            <a class="tool-nav__link @(Model == DeckPageTab.Convert ? "is-active" : string.Empty)" href="@Url.Content("~/convert")">Convert Deck</a>
            <a class="tool-nav__link @(Model == DeckPageTab.DeckPrimer ? "is-active" : string.Empty)" href="@Url.Content("~/deck-primer")">Deck Primer</a>
        </div>
    </div>
    <div class="tool-nav__group @(referenceActive ? "is-active" : string.Empty)" data-tool-nav-group>
        <button type="button" class="tool-nav__trigger" aria-expanded="false" aria-haspopup="true" data-tool-nav-trigger>
            Reference
        </button>
        <div class="tool-nav__dropdown">
            <a class="tool-nav__link @(Model == DeckPageTab.CardLookup ? "is-active" : string.Empty)" href="@Url.Content("~/card-lookup")">Card Lookup</a>
            <a class="tool-nav__link @(Model == DeckPageTab.MechanicLookup ? "is-active" : string.Empty)" href="@Url.Content("~/mechanic-lookup")">Mechanic Rules</a>
            <a class="tool-nav__link @(Model == DeckPageTab.JudgeQuestions ? "is-active" : string.Empty)" href="@Url.Content("~/judge-questions")">Ask a Judge</a>
            @if (FlagCache.IsEnabled("content.kb.enabled"))
            {
                <a class="tool-nav__link @(Model == DeckPageTab.ContentKb ? "is-active" : string.Empty)" href="@Url.Action("Index", "ContentKb")" title="Browse distilled creator advice and copyable prompts">Knowledge Base</a>
            }
        </div>
    </div>
    <div class="tool-nav__group @(categoriesActive ? "is-active" : string.Empty)" data-tool-nav-group>
        <button type="button" class="tool-nav__trigger" aria-expanded="false" aria-haspopup="true" data-tool-nav-trigger>
            Categories
        </button>
        <div class="tool-nav__dropdown">
            @if (FlagCache.IsEnabled("feature.categories.enabled"))
            {
                <a class="tool-nav__link @(Model == DeckPageTab.SuggestCategories ? "is-active" : string.Empty)" href="@Url.Content("~/suggest-categories")">Category Suggestions</a>
            }
            else
            {
                <span class="tool-nav__link tool-nav__link--muted">Suggestions offline</span>
            }
            <a class="tool-nav__link @(Model == DeckPageTab.CommanderCategories ? "is-active" : string.Empty)" href="@Url.Content("~/commander-categories")">Category Reference</a>
        </div>
    </div>
</nav>
