@model DeckFlow.Web.Models.Admin.AdminHarvestViewModel
@{
    ViewData["Title"] = "Harvest";
    var activeState = Model.ActiveRun?.State.ToString() ?? "Idle";
}

<noscript>
    <meta http-equiv="refresh" content="5" />
</noscript>

@if (!string.IsNullOrEmpty(Model.LastBanner))
{
    <div class="admin-banner admin-banner--success">@Model.LastBanner</div>
}

<div class="admin-harvest__tabs" role="tablist" aria-label="Harvest sections">
    <button type="button" id="harvest-tab-overview" data-harvest-tab="overview" role="tab" aria-controls="harvest-panel-overview" aria-selected="true" tabindex="0">Overview</button>
    <button type="button" id="harvest-tab-commanders" data-harvest-tab="commanders" role="tab" aria-controls="harvest-panel-commanders" aria-selected="false" tabindex="-1">Commanders</button>
</div>

<section id="harvest-panel-overview" role="tabpanel" data-harvest-panel="overview" aria-labelledby="harvest-tab-overview">
@if (Model.Stats is not null)
{
    <partial name="_HarvestHealthStrip" model="Model.Stats" />
}
else
{
    <p class="admin-harvest__health-unavailable">Stats unavailable.</p>
}
<section class="admin-harvest__panel">
    <h2>Run Now</h2>
    <form method="post" asp-action="RunNow" class="admin-action-form">
        @Html.AntiForgeryToken()
        <label for="durationSeconds">Duration</label>
        <select id="durationSeconds" name="durationSeconds">
            @foreach (var durationSeconds in Model.DurationOptions)
            {
                var minutes = durationSeconds / 60;
                <option value="@durationSeconds" selected="@(durationSeconds == 3600 ? "selected" : null)">@minutes minutes</option>
            }
        </select>
        <button type="submit">Run Now</button>
    </form>

    @if (Model.ActiveRun is not null)
    {
        <form method="post" asp-action="Cancel" asp-route-jobId="@Model.ActiveRun.Id" class="admin-action-form">
            @Html.AntiForgeryToken()
            <button type="submit">Cancel</button>
        </form>
    }

    <div id="harvest-status-live" role="status" aria-live="polite" data-harvest-status data-state="@activeState">
        <strong>Status:</strong> <span class="admin-harvest__state">@activeState</span>
        @if (Model.ActiveRun is not null)
        {
            <span> | Decks: <span class="admin-harvest__decks">@Model.ActiveRun.DecksProcessed</span></span>
            <span> | Started: <span class="admin-harvest__started">@(Model.ActiveRun.StartedUtc?.ToString("u") ?? "Queued")</span></span>
            <span> | Elapsed: <span class="admin-harvest__elapsed">—</span></span>
        }
        else
        {
            <span> | Decks: <span class="admin-harvest__decks">0</span></span>
            <span> | Started: <span class="admin-harvest__started">—</span></span>
            <span> | Elapsed: <span class="admin-harvest__elapsed">—</span></span>
        }
    </div>
</section>

<section class="admin-harvest__panel">
    <h2>Schedule</h2>
    <form method="post" asp-action="SaveSchedule" class="admin-action-form">
        @Html.AntiForgeryToken()
        <label for="intervalHours">Interval</label>
        <select id="intervalHours" name="intervalHours">
            <option value="">Off</option>
            @foreach (var intervalHours in Model.IntervalOptions)
            {
                <option value="@intervalHours" selected="@(Model.Schedule.IntervalHours == intervalHours ? "selected" : null)">Every @intervalHours hours</option>
            }
        </select>
        <input type="hidden" name="paused" value="@(Model.Schedule.Paused.ToString().ToLowerInvariant())" />
        <button type="submit">Save</button>
    </form>

    <form method="post" asp-action="PauseSchedule" class="admin-action-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="paused" value="@((!Model.Schedule.Paused).ToString().ToLowerInvariant())" />
        <button type="submit">@(Model.Schedule.Paused ? "Resume" : "Pause")</button>
    </form>

    <p>Current interval: @(Model.Schedule.IntervalHours?.ToString() ?? "Off")</p>
    <p>Paused: @(Model.Schedule.Paused ? "Yes" : "No")</p>
    @if (Model.Stats is not null)
    {
        <partial name="_HarvestZeroDiscovery" model="Model.Stats.Health" />
    }
</section>

<section class="admin-harvest__panel">
    <h2>Stats</h2>
    @if (Model.Stats is not null)
    {
        <p>Decks processed in last 30 days: @Model.Stats.TotalDecks30d</p>
        <p>Total observations: @Model.Stats.TotalObservations</p>
        <p>Last successful run: @(Model.Stats.LastSuccessUtc?.ToString("yyyy-MM-dd HH:mm UTC") ?? "Never")</p>
        <p>Next scheduled run: @(Model.Stats.NextScheduledUtc?.ToString("yyyy-MM-dd HH:mm UTC") ?? "Off")</p>
        <p>Decks Processed counts written decks (added + updated); unchanged cache hits are skipped to reduce write churn.</p>
    }

    @await Html.PartialAsync("_HarvestRunLog", Model.Stats?.RecentRuns ?? Model.RecentRuns)

</section>

<details id="harvest-import-panel" class="admin-harvest__disclosure">
    <summary>Import a single URL</summary>
    <form method="post" asp-action="SubmitUrl" class="admin-action-form">
        @Html.AntiForgeryToken()
        <label for="url">Archidekt URL</label>
        <input id="url" type="url" name="url" autocomplete="url" inputmode="url" placeholder="https://archidekt.com/decks/…" required />
        <button type="submit">Submit</button>
    </form>
</details>

</section>

<section id="harvest-panel-commanders" role="tabpanel" data-harvest-panel="commanders" aria-labelledby="harvest-tab-commanders" hidden>
    <section id="harvested-commanders" class="admin-harvest__panel">
        <h2>Harvested Commanders</h2>
        <div id="commanders-grid-container" aria-live="polite" aria-busy="false" aria-label="Harvested commanders grid">
            <p class="admin-harvest__grid-idle">The commander list loads when this tab is opened.</p>
        </div>
    </section>
</section>

@section Scripts
{
    <script src="~/js/admin-harvest.js" asp-append-version="true"></script>
}
