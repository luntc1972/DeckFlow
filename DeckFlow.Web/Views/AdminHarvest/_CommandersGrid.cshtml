@using DeckFlow.Core.Knowledge
@model DeckFlow.Web.Models.Admin.CommandersGridViewModel
@using System.Globalization
@{
    static string FormatLastProcessedUtc(string? lastProcessedUtc)
    {
        if (string.IsNullOrWhiteSpace(lastProcessedUtc))
        {
            return "—";
        }

        return DateTimeOffset.TryParse(
            lastProcessedUtc,
            CultureInfo.InvariantCulture,
            DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal,
            out var parsed)
            ? parsed.UtcDateTime.ToString("u", CultureInfo.InvariantCulture)
            : lastProcessedUtc;
    }

    var totalPages = Model.DeckTotalPages;
    var currentPage = Model.DeckPage;
    var pages = new SortedSet<int>();

    if (totalPages <= 7)
    {
        for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
        {
            pages.Add(pageNumber);
        }
    }
    else
    {
        pages.Add(1);

        for (var pageNumber = Math.Max(1, currentPage - 2); pageNumber <= Math.Min(totalPages, currentPage + 2); pageNumber++)
        {
            pages.Add(pageNumber);
        }

        pages.Add(totalPages);
    }
}
<p class="admin-harvest__grid-meta">@Model.DeckTotalCount commanders — Page @Model.DeckPage of @Model.DeckTotalPages</p>

@if (Model.HarvestedCommanders.Count == 0)
{
    <p class="admin-empty">@(Model.Query.SearchTerm is null ? "No harvested commanders yet." : $"No commanders start with \"{Model.Query.SearchTerm}\".")</p>
}
else
{
    <div class="admin-table-scroll" role="region" aria-label="Harvested commanders - scroll horizontally to see all columns" tabindex="0">
        <table class="admin-table">
            <caption class="sr-only">Harvested commanders with deck count and last processed timestamp</caption>
            <thead>
                <tr>
                    <th scope="col">#</th>
                    @foreach (var (column, token, label) in new[] { (CommanderSortColumn.Name, "name", "Commander"), (CommanderSortColumn.DeckCount, "deck_count", "Decks Categorized"), (CommanderSortColumn.LastProcessed, "last_processed", "Last Processed (UTC)") })
                    {
                        <th scope="col" aria-sort="@(Model.Query.IsActive(column) ? (Model.Query.Descending ? "descending" : "ascending") : "none")">
                            <button type="button" class="admin-table__sort-header" data-sort-column="@token" data-sort-next-dir="@Model.Query.NextDirectionToken(column)"><span>@label</span>@if (Model.Query.IsActive(column)) { <span class="admin-table__sort-indicator" aria-hidden="true">@(Model.Query.Descending ? "↓" : "↑")</span> }</button>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @{
                    var rankOffset = (Model.DeckPage - 1) * Model.DeckPageSize;
                }
                @for (var i = 0; i < Model.HarvestedCommanders.Count; i++)
                {
                    var c = Model.HarvestedCommanders[i];
                    <tr>
                        <td>@(rankOffset + i + 1)</td>
                        <td>@c.CommanderName</td>
                        <td>@c.DeckCount</td>
                        <td>@FormatLastProcessedUtc(c.LastProcessedUtc)</td>
                    </tr>
                    <tr class="admin-harvest__category-row">
                        <td colspan="4">
                            <details class="admin-harvest__category-toggle" data-commander-details="@c.CommanderName">
                                <summary>Category breakdown</summary>
                                <div data-commander-panel></div>
                            </details>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.DeckTotalPages > 1)
    {
        <nav class="admin-feedback-pagination admin-harvest__grid-pager" aria-label="Commander grid pagination">
            @if (currentPage > 1)
            {
                <a href="#" data-page="@(currentPage - 1)" data-search="@Model.Query.SearchTerm" data-sort-by="@Model.Query.SortByToken" data-sort-dir="@Model.Query.SortDirToken">Prev</a>
            }

            @{
                int? previousPage = null;
            }
            @foreach (var pageNumber in pages)
            {
                if (previousPage.HasValue && pageNumber - previousPage.Value > 1)
                {
                    <span aria-hidden="true">…</span>
                }

                if (pageNumber == currentPage)
                {
                    <strong aria-current="page">@pageNumber</strong>
                }
                else
                {
                    <a href="#" data-page="@pageNumber" data-search="@Model.Query.SearchTerm" data-sort-by="@Model.Query.SortByToken" data-sort-dir="@Model.Query.SortDirToken">@pageNumber</a>
                }

                previousPage = pageNumber;
            }

            @if (currentPage < totalPages)
            {
                <a href="#" data-page="@(currentPage + 1)" data-search="@Model.Query.SearchTerm" data-sort-by="@Model.Query.SortByToken" data-sort-dir="@Model.Query.SortDirToken">Next</a>
            }
        </nav>
    }
}
