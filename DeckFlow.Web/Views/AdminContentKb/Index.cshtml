@model DeckFlow.Web.Models.AdminContentKbViewModel
@using DeckFlow.Core.Content
@{
    ViewData["Title"] = "Content KB";
    ViewData["Lede"] = "Curate which distilled Content KB prompts are published to the site.";
    var allFilterUrl = Url.Action("Index", new
    {
        visibilityFilter = "all"
    });
    var publishedFilterUrl = Url.Action("Index", new
    {
        visibilityFilter = "published"
    });
    var unpublishedFilterUrl = Url.Action("Index", new
    {
        visibilityFilter = "unpublished"
    });
    var hiddenFilterUrl = Url.Action("Index", new
    {
        visibilityFilter = "hidden"
    });
}

@if (!string.IsNullOrEmpty(Model.SuccessBanner))
{
    <p class="admin-banner admin-banner--success" role="status" data-admin-toast>@Model.SuccessBanner</p>
}

<section class="admin-harvest__panel" aria-labelledby="kb-status-heading">
    <h2 id="kb-status-heading">Index Status</h2>
    <p>@Model.Status.TotalCount total - @Model.Status.PublishedCount published, @Model.Status.UnpublishedCount unpublished, @Model.Status.HiddenCount hidden</p>
    <p>@Model.Status.SourceCount sources</p>
    <p>
        Index generated:
        @(Model.Status.IndexGeneratedUtc is { } generated
            ? generated.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss") + " UTC"
            : "Never")
    </p>

    <div class="admin-kb-status__actions">
        <form method="post" asp-controller="AdminFlags" asp-action="Toggle"
              asp-route-key="tool.knowledge-base.enabled" asp-route-enabled="@((!Model.Status.FlagEnabled).ToString().ToLowerInvariant())"
              class="admin-action-form">
            @Html.AntiForgeryToken()
            <button type="submit">@(Model.Status.FlagEnabled ? "Disable" : "Enable")</button>
        </form>

        <form method="post" asp-action="ReloadSeed" class="admin-action-form" data-admin-confirm-reload>
            @Html.AntiForgeryToken()
            <input type="hidden" name="visibilityFilter" value="@Model.VisibilityFilter" />
            <button type="submit">Reload Index from Seed</button>
        </form>
    </div>
</section>

<section aria-labelledby="creator-suppression-heading">
    <h2 id="creator-suppression-heading">Creator suppression</h2>
    <form method="post" asp-action="SuppressCreator" class="admin-action-form">
        @Html.AntiForgeryToken()
        <label>Creator <input name="creator" required /></label>
        <label>Reason <input name="reason" required /></label>
        <label>Note <input name="note" /></label>
        <button type="submit">Suppress creator</button>
    </form>
    <form method="post" asp-action="PurgeCreator" class="admin-action-form">
        @Html.AntiForgeryToken()
        <label>Creator <input name="creator" required /></label>
        <label>Confirm canonical slug <input name="confirmSlug" required /></label>
        <p class="admin-error" role="alert">Purge deletes stored creator records. Type the exact canonical slug; artifact folders must be deleted by hand.</p>
        <button type="submit">Purge creator</button>
    </form>
</section>

@if (Model.Sources.Count > 0)
{
    <section aria-labelledby="kb-bulk-heading">
        <h2 id="kb-bulk-heading">Sources</h2>
        <table class="admin-table admin-table--card">
            <caption class="sr-only">Content sources — bulk publish controls</caption>
            <thead>
                <tr>
                    <th scope="col">Source</th>
                    <th scope="col">Entries</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var source in Model.Sources)
                {
                    <tr>
                        <td data-label="Source"><strong>@source.Source</strong></td>
                        <td data-label="Entries">@source.EntryCount</td>
                        <td data-label="Actions">
                            <form method="post" asp-action="BulkSetVisibility" class="admin-action-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="visibilityFilter" value="@Model.VisibilityFilter" />
                                <input type="hidden" name="source" value="@source.Source" />
                                <input type="hidden" name="visible" value="true" />
                                <button type="submit" aria-label="Publish all entries from @source.Source">Publish All</button>
                            </form>
                            <form method="post" asp-action="BulkHide" class="admin-action-form" data-admin-confirm-twoclick>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="visibilityFilter" value="@Model.VisibilityFilter" />
                                <input type="hidden" name="source" value="@source.Source" />
                                <button type="submit" class="danger" data-confirm-label="Confirm Hide All"
                                        aria-label="Hide all entries from @source.Source">Hide All</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

<section class="admin-card" aria-labelledby="kb-entries-heading">
    <div class="admin-section-header">
        <div>
            <h2 id="kb-entries-heading" class="admin-card__title">Entries</h2>
        </div>
        <nav class="admin-filter-chips" data-kb-visibility aria-label="Visibility filter">
            <a class="admin-filter-chips__chip @(Model.VisibilityFilter == "all" ? "is-active" : null)" href="@allFilterUrl" aria-current="@(Model.VisibilityFilter == "all" ? "true" : null)">All</a>
            <a class="admin-filter-chips__chip @(Model.VisibilityFilter == "published" ? "is-active" : null)" href="@publishedFilterUrl" aria-current="@(Model.VisibilityFilter == "published" ? "true" : null)">Published</a>
            <a class="admin-filter-chips__chip @(Model.VisibilityFilter == "unpublished" ? "is-active" : null)" href="@unpublishedFilterUrl" aria-current="@(Model.VisibilityFilter == "unpublished" ? "true" : null)">Unpublished</a>
            <a class="admin-filter-chips__chip @(Model.VisibilityFilter == "hidden" ? "is-active" : null)" href="@hiddenFilterUrl" aria-current="@(Model.VisibilityFilter == "hidden" ? "true" : null)">Hidden</a>
        </nav>
    </div>
    @if (Model.Entries.Count == 0)
    {
        <p class="admin-empty">@(Model.Status.TotalCount == 0
            ? "No entries loaded. Use 'Reload Index from Seed' to populate the index."
            : "No entries match the current filter.")</p>
    }
    else
    {
        <div class="admin-filter">
            <div class="admin-field admin-filter-search">
                <label for="kb-filter-search">Filter entries</label>
                <input id="kb-filter-search" type="search" autocomplete="off" placeholder="Filter by title, source, or tag" aria-controls="kb-entries-table" />
            </div>
            <div class="admin-field">
                <label for="kb-creator-filter">Creator</label>
                <select id="kb-creator-filter" autocomplete="off" aria-controls="kb-entries-table">
                    <option value="">All creators</option>
                    @foreach (var source in Model.Sources)
                    {
                        <option value="@source.Source">@source.Source</option>
                    }
                </select>
            </div>
            <p class="admin-filter__count" id="kb-filter-count" role="status" aria-live="polite"></p>
        </div>
        <div class="admin-table-scroll" tabindex="0">
            <table id="kb-entries-table" class="admin-table admin-table--card">
                <caption class="sr-only">Content KB entries — per-entry publish controls</caption>
                <thead>
                    <tr>
                        <th scope="col">Title</th>
                        <th scope="col">Source</th>
                        <th scope="col">Tags</th>
                        <th scope="col">Status</th>
                        <th scope="col">Publish State</th>
                        <th scope="col">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.Entries)
                    {
                        var searchText = (entry.Title + " " + entry.Source + " " + string.Join(" ", entry.Tags)).ToLowerInvariant();
                        <tr data-kb-search="@searchText" data-kb-source="@entry.Source">
                            <td data-label="Title" class="admin-kb-title">@entry.Title</td>
                            <td data-label="Source" class="admin-kb-source">@entry.Source</td>
                            <td data-label="Tags">
                                @foreach (var tag in entry.Tags)
                                {
                                    <span class="admin-badge admin-badge--neutral">@tag</span>
                                }
                            </td>
                            <td data-label="Status">
                                @if (entry.IsVisible)
                                {
                                    <span class="admin-badge admin-badge--success" aria-label="Published">Published</span>
                                }
                                else if (entry.IsHidden)
                                {
                                    <span class="admin-badge admin-badge--neutral" aria-label="Hidden">Hidden</span>
                                }
                                else
                                {
                                    <span class="admin-badge admin-badge--warning" aria-label="Unpublished">Unpublished</span>
                                }
                            </td>
                            <td data-label="Publish State">
                                <span class="admin-badge @(entry.PublishState switch
                                {
                                    DeckFlow.Core.Content.PublishState.Published => "admin-badge--success",
                                    DeckFlow.Core.Content.PublishState.PushedHidden => "admin-badge--neutral",
                                    DeckFlow.Core.Content.PublishState.LocalNewer => "admin-badge--info",
                                    _ => "admin-badge--warning",
                                })">@entry.PublishState.ToDisplayString()</span>
                            </td>
                            <td data-label="Action">
                                @if (entry.IsVisible)
                                {
                                    <form method="post" asp-action="SetVisibility" class="admin-action-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="visibilityFilter" value="@Model.VisibilityFilter" />
                                        <input type="hidden" name="entryId" value="@entry.Id" />
                                        <input type="hidden" name="visible" value="false" />
                                        <button type="submit" class="admin-button admin-button--secondary" aria-label="Unpublish '@entry.Title'">Unpublish</button>
                                    </form>
                                    <form method="post" asp-action="Hide" class="admin-action-form" data-admin-confirm-twoclick>
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="visibilityFilter" value="@Model.VisibilityFilter" />
                                        <input type="hidden" name="entryId" value="@entry.Id" />
                                        <button type="submit" class="admin-button admin-button--danger" data-confirm-label="Confirm hide" aria-label="Hide '@entry.Title'">Hide</button>
                                    </form>
                                }
                                else if (entry.IsHidden)
                                {
                                    <form method="post" asp-action="SetVisibility" class="admin-action-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="visibilityFilter" value="@Model.VisibilityFilter" />
                                        <input type="hidden" name="entryId" value="@entry.Id" />
                                        <input type="hidden" name="visible" value="true" />
                                        <button type="submit" class="admin-button admin-button--secondary" aria-label="Publish '@entry.Title'">Publish</button>
                                    </form>
                                    <form method="post" asp-action="SetVisibility" class="admin-action-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="visibilityFilter" value="@Model.VisibilityFilter" />
                                        <input type="hidden" name="entryId" value="@entry.Id" />
                                        <input type="hidden" name="visible" value="false" />
                                        <button type="submit" class="admin-button admin-button--secondary" aria-label="Unpublish '@entry.Title'">Unpublish</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-action="SetVisibility" class="admin-action-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="visibilityFilter" value="@Model.VisibilityFilter" />
                                        <input type="hidden" name="entryId" value="@entry.Id" />
                                        <input type="hidden" name="visible" value="true" />
                                        <button type="submit" class="admin-button admin-button--secondary" aria-label="Publish '@entry.Title'">Publish</button>
                                    </form>
                                    <form method="post" asp-action="Hide" class="admin-action-form" data-admin-confirm-twoclick>
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="visibilityFilter" value="@Model.VisibilityFilter" />
                                        <input type="hidden" name="entryId" value="@entry.Id" />
                                        <button type="submit" class="admin-button admin-button--danger" data-confirm-label="Confirm hide" aria-label="Hide '@entry.Title'">Hide</button>
                                    </form>
                                }
                                <form method="post" asp-action="SetEvergreen" class="admin-action-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="visibilityFilter" value="@Model.VisibilityFilter" />
                                    <input type="hidden" name="entryId" value="@entry.Id" />
                                    <input type="hidden" name="evergreen" value="@((!entry.IsEvergreen).ToString().ToLowerInvariant())" />
                                    @if (entry.IsEvergreen)
                                    {
                                        <button type="submit" class="admin-button admin-button--secondary" aria-label="Remove evergreen flag from '@entry.Title'">Evergreen: On</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="admin-button admin-button--secondary" aria-label="Mark '@entry.Title' as evergreen">Evergreen: Off</button>
                                    }
                                </form>
                                <form method="post" asp-action="DeleteEntry" class="admin-action-form" data-admin-confirm-twoclick>
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="visibilityFilter" value="@Model.VisibilityFilter" />
                                    <input type="hidden" name="entryId" value="@entry.Id" />
                                    <button type="submit" class="admin-button admin-button--danger" data-confirm-label="Confirm delete" aria-label="Delete '@entry.Title' permanently">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    <tr class="admin-filter__empty-row hidden" id="kb-filter-empty">
                        <td colspan="6">No entries match the current filter.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</section>

@await Html.PartialAsync("_AdminConfirmModal")

@section Scripts
{
    <script src="~/js/admin-modal.js" asp-append-version="true"></script>
    <script src="~/js/kb-entry-filter.js" asp-append-version="true"></script>
    <script src="~/js/content-kb-admin.js" asp-append-version="true"></script>
}
