@page "/data-coverage"
@inherits StudioCancellableComponentBase

<PageTitle>Data Coverage</PageTitle>

<div class="container-fluid">
    <h1>Data Coverage</h1>
    <p class="text-muted">Read-only audit of visible, approved production content against <code>/data</code>.</p>

    <button class="btn btn-outline-primary" @onclick="RunAuditAsync" disabled="@_isRunning">
        @(_isRunning ? "Running audit…" : "Run audit")
    </button>

    @if (!string.IsNullOrEmpty(_runError))
    {
        <div class="alert alert-danger mt-3">@_runError</div>
    }

    @if (_report is not null)
    {
        <div class="mt-3" data-testid="data-coverage-results">
            <ul>
                <li>Live rows (visible and approved): @_report.TotalLiveCount</li>
                <li>Present + match: @_report.PresentMatchCount</li>
                <li>Present + mismatch: @_report.PresentMismatchCount</li>
                <li>Missing: @_report.MissingCount</li>
                <li>No stored hash: @_report.NoStoredHashCount</li>
            </ul>

            @if (_report.FailingRows.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead><tr><th>Artifact path</th><th>Bucket</th></tr></thead>
                        <tbody>
                            @foreach (var row in _report.FailingRows)
                            {
                                <tr><td><code>@row.ArtifactPath</code></td><td>@FormatBucket(row.Bucket)</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>
