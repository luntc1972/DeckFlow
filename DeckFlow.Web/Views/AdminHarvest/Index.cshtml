@model DeckFlow.Web.Models.Admin.AdminHarvestViewModel
@{
    ViewData["Title"] = "Harvest";
    ViewData["Lede"] = "Run and monitor deck-knowledge harvest jobs and view stats.";
    var activeState = Model.ActiveRun?.State.ToString() ?? "Idle";
    static string NextRunLabel(DateTimeOffset? nextRun, bool enabled, bool paused)
        => !enabled ? "Off" : paused ? "Paused" : nextRun?.ToString("yyyy-MM-dd HH:mm UTC") ?? "Pending";
}

<noscript>
    <meta http-equiv="refresh" content="5" />
</noscript>

@if (!string.IsNullOrEmpty(Model.LastBanner))
{
    <div class="admin-banner @(Model.LastBannerIsError ? "admin-banner--danger" : "admin-banner--success")" role="@(Model.LastBannerIsError ? "alert" : "status")">@Model.LastBanner</div>
}

<div class="admin-tabs" role="tablist" aria-label="Harvest sections">
    <button class="admin-tabs__tab" type="button" id="harvest-tab-overview" data-harvest-tab="overview" role="tab" aria-controls="harvest-panel-overview" aria-selected="true" tabindex="0">Overview</button>
    <button class="admin-tabs__tab" type="button" id="harvest-tab-commanders" data-harvest-tab="commanders" role="tab" aria-controls="harvest-panel-commanders" aria-selected="false" tabindex="-1">Commanders</button>
</div>

<section id="harvest-panel-overview" role="tabpanel" data-harvest-panel="overview" aria-labelledby="harvest-tab-overview">
<div class="admin-stack">
@if (Model.Stats is not null)
{
    <partial name="_HarvestHealthStrip" model="Model.Stats" />
}
else
{
    <p class="admin-empty">Stats unavailable.</p>
}
<section class="admin-card">
    <h2 class="admin-card__title">Run Now</h2>
    <form method="post" asp-action="RunNow" class="admin-action-form">
        @Html.AntiForgeryToken()
        <div class="admin-field">
            <label for="runKind">Kind</label>
            <select id="runKind" name="kind">
                @foreach (var kind in Model.RunKindOptions)
                {
                    <option value="@DeckFlow.Web.Models.Admin.AdminHarvestViewModel.RunKindToken(kind)">@kind</option>
                }
            </select>
        </div>
        <div class="admin-field">
        <label for="durationSeconds">Duration</label>
        <select id="durationSeconds" name="durationSeconds">
            @foreach (var durationSeconds in Model.DurationOptions)
            {
                var minutes = durationSeconds / 60;
                <option value="@durationSeconds" selected="@(durationSeconds == 3600 ? "selected" : null)">@minutes minutes</option>
            }
        </select>
        </div>
        <p class="admin-meta">Duration applies to bulk runs only. Update runs stop after @DeckFlow.Web.Models.Admin.AdminHarvestViewModel.UpdateRunCapMinutes minutes.</p>
        <button class="admin-button admin-button--primary" type="submit">Run Now</button>
    </form>

    @if (Model.ActiveRun is not null)
    {
        <form method="post" asp-action="Cancel" asp-route-jobId="@Model.ActiveRun.Id" class="admin-action-form">
            @Html.AntiForgeryToken()
            <button class="admin-button admin-button--danger" type="submit">Cancel</button>
        </form>
    }

    <div id="harvest-status-live" role="status" aria-live="polite" data-harvest-status data-state="@activeState">
        <strong>Status:</strong> <span class="admin-harvest__state">@activeState</span>
        @if (Model.ActiveRun is not null)
        {
            <span> | Decks: <span class="admin-harvest__decks">@Model.ActiveRun.DecksProcessed</span></span>
            <span> | Started: <span class="admin-harvest__started">@(Model.ActiveRun.StartedUtc?.ToString("u") ?? "Queued")</span></span>
            <span> | Elapsed: <span class="admin-harvest__elapsed">—</span></span>
        }
        else
        {
            <span> | Decks: <span class="admin-harvest__decks">0</span></span>
            <span> | Started: <span class="admin-harvest__started">—</span></span>
            <span> | Elapsed: <span class="admin-harvest__elapsed">—</span></span>
        }
    </div>
</section>

<section id="harvest-bulk-schedule" class="admin-card">
    <h2 class="admin-card__title">Bulk Schedule</h2>
    <form method="post" asp-action="SaveSchedule" class="admin-action-form">
        @Html.AntiForgeryToken()
        <div class="admin-field">
        <label for="intervalHours">Interval</label>
        <select id="intervalHours" name="intervalHours">
            <option value="">Off</option>
            @foreach (var intervalHours in Model.IntervalOptions)
            {
                <option value="@intervalHours" selected="@(Model.Schedule.IntervalHours == intervalHours ? "selected" : null)">Every @intervalHours hours</option>
            }
        </select>
        </div>
        <input type="hidden" name="paused" value="@(Model.Schedule.Paused.ToString().ToLowerInvariant())" />
        <button class="admin-button admin-button--primary" type="submit">Save</button>
    </form>

    <form method="post" asp-action="PauseSchedule" class="admin-action-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="paused" value="@((!Model.Schedule.Paused).ToString().ToLowerInvariant())" />
        <button class="admin-button admin-button--secondary" type="submit">@(Model.Schedule.Paused ? "Resume" : "Pause")</button>
    </form>

    <p>Current interval: @(Model.Schedule.IntervalHours?.ToString() ?? "Off")</p>
    <p>Paused: @(Model.Schedule.Paused ? "Yes" : "No")</p>
    @if (Model.Stats is not null)
    {
        <partial name="_HarvestZeroDiscovery" model="Model.Stats.Health" />
    }
</section>

<section id="harvest-update-schedule" class="admin-card">
    <h2 class="admin-card__title">Update Schedule</h2>
    <form method="post" asp-action="SaveUpdateSchedule" class="admin-action-form">
        @Html.AntiForgeryToken()
        <div class="admin-field">
            <label for="updateIntervalMinutes">Interval</label>
            <select id="updateIntervalMinutes" name="intervalMinutes">
                <option value="">Off</option>
                @foreach (var intervalMinutes in Model.UpdateIntervalOptions)
                {
                    <option value="@intervalMinutes" selected="@(Model.UpdateSchedule.IntervalMinutes == intervalMinutes ? "selected" : null)">Every @intervalMinutes minutes</option>
                }
            </select>
        </div>
        <input type="hidden" name="paused" value="@(Model.UpdateSchedule.Paused.ToString().ToLowerInvariant())" />
        <button class="admin-button admin-button--primary" type="submit">Save</button>
    </form>

    <form method="post" asp-action="PauseUpdateSchedule" class="admin-action-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="paused" value="@((!Model.UpdateSchedule.Paused).ToString().ToLowerInvariant())" />
        <button class="admin-button admin-button--secondary" type="submit">@(Model.UpdateSchedule.Paused ? "Resume" : "Pause")</button>
    </form>

    <p>Current interval: @(Model.UpdateSchedule.IntervalMinutes.HasValue ? $"Every {Model.UpdateSchedule.IntervalMinutes.Value} minutes" : "Off")</p>
    <p>Paused: @(Model.UpdateSchedule.Paused ? "Yes" : "No")</p>
    <p class="admin-meta">Cadence is a research estimate; update harvesting samples recent changes.</p>
</section>

<section class="admin-card" id="harvest-rate-card">
    <h2 class="admin-card__title">Archidekt rate</h2>
    <form method="post" asp-action="SaveRate" class="admin-action-form">
        @Html.AntiForgeryToken()
        <div class="admin-field">
            <label for="ratePerMinute">Requests per minute</label>
            <select id="ratePerMinute" name="ratePerMinute">
                @foreach (var ratePerMinute in Model.RateOptions)
                {
                    <option value="@ratePerMinute" selected="@(ratePerMinute == Model.RatePerMinute ? "selected" : null)">@ratePerMinute per minute</option>
                }
            </select>
        </div>
        <button class="admin-button admin-button--primary" type="submit">Save rate</button>
    </form>
    <p class="admin-meta">Code ceiling: @Model.RateCeilingPerMinute requests per minute. Interactive Archidekt imports share this limit.</p>
</section>

<section class="admin-card">
    <h2 class="admin-card__title">Stats</h2>
    @if (Model.Stats is not null)
    {
        <p>Decks processed in last 30 days: @Model.Stats.TotalDecks30d</p>
        <p>Total observations: @Model.Stats.TotalObservations</p>
        <p>Last scheduled bulk run: @(Model.Stats.LastBulkScheduledSuccessUtc?.ToString("yyyy-MM-dd HH:mm UTC") ?? "Never")</p>
        <p>Next scheduled bulk run: @NextRunLabel(Model.Stats.NextBulkScheduledUtc, Model.Schedule.IntervalHours.HasValue, Model.Schedule.Paused)</p>
        <p>Last scheduled update run: @(Model.Stats.LastUpdateScheduledSuccessUtc?.ToString("yyyy-MM-dd HH:mm UTC") ?? "Never")</p>
        <p>Next scheduled update run: @NextRunLabel(Model.Stats.NextUpdateScheduledUtc, Model.UpdateSchedule.IntervalMinutes.HasValue, Model.UpdateSchedule.Paused)</p>
        <p class="admin-meta">Decks Processed counts written decks (added + updated); unchanged cache hits are skipped to reduce write churn.</p>
    }

    @await Html.PartialAsync("_HarvestRunLog", Model.Stats?.RecentRuns ?? Model.RecentRuns)

</section>

<details id="harvest-import-panel" class="admin-card">
    <summary class="admin-card__title">Import a single URL</summary>
    <form method="post" asp-action="SubmitUrl" class="admin-action-form">
        @Html.AntiForgeryToken()
        <div class="admin-field">
        <label for="url">Archidekt URL</label>
        <input id="url" type="url" name="url" autocomplete="url" inputmode="url" placeholder="https://archidekt.com/decks/…" required />
        </div>
        <button class="admin-button admin-button--primary" type="submit">Submit</button>
    </form>
</details>

</div>
</section>

<section id="harvest-panel-commanders" role="tabpanel" data-harvest-panel="commanders" aria-labelledby="harvest-tab-commanders" hidden>
    <div class="admin-stack">
    <section id="harvested-commanders" class="admin-card">
        <h2 class="admin-card__title">Harvested Commanders</h2>
        <form id="commanders-search-form" class="admin-filter" role="search">
            <div class="admin-field admin-filter-search">
            <label for="commanders-search">Search commanders</label>
            <input id="commanders-search" name="search" type="search" maxlength="100" autocomplete="off" placeholder="Commander name starts with…" />
            </div>
            <button class="admin-button admin-button--secondary" id="commanders-search-clear" type="button">Clear</button>
            <button class="admin-button admin-button--primary" type="submit">Search</button>
        </form>
        <form method="post" asp-action="ExportCommanders" class="admin-action-form admin-harvest__export-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="search" value="" data-export-search />
            <input type="hidden" name="sortBy" value="deck_count" data-export-sort-by />
            <input type="hidden" name="sortDir" value="desc" data-export-sort-dir />
            <button class="admin-button admin-button--secondary" type="submit">Export CSV</button>
        </form>
        <div id="commanders-grid-container" aria-live="polite" aria-busy="false" aria-label="Harvested commanders grid">
            <p class="admin-empty">The commander list loads when this tab is opened.</p>
        </div>
    </section>
</div>
</section>

@section Scripts
{
    <script src="~/js/admin-harvest.js" asp-append-version="true"></script>
}
