# Normalize line endings. DeckFlow is cross-platform (WSL + Windows + Linux containers).
# Without this, Windows IDEs (VS, Rider) silently flip CRLF<->LF on save, producing
# huge whitespace-only diffs. The autocrlf=input setting on Linux + autocrlf=true on
# Windows produces the SAME canonical form (LF in repo).

* text=auto eol=lf

# Source — LF in repo.
*.cs        text eol=lf
*.cshtml    text eol=lf
*.razor     text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.sln       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.ts        text eol=lf
*.js        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.svg       text eol=lf
*.xml       text eol=lf
*.config    text eol=lf
*.editorconfig text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf
Dockerfile  text eol=lf

# Shell — LF (executed in Linux containers).
*.sh        text eol=lf

# PowerShell + Windows scripts — CRLF (Windows-only consumers).
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary assets — never normalize.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.zip       binary
*.tar       binary
*.gz        binary
*.7z        binary
*.pdf       binary
*.db        binary
*.sqlite    binary
*.sqlite3   binary
*.woff      binary
*.woff2     binary
*.eot       binary
*.ttf       binary
*.otf       binary
*.dll       binary
*.exe       binary
*.pdb       binary
