<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Override the transitive SQLitePCLRaw 2.1.11 (NU1903 / GHSA-2m69-gcr7-jv3q: the whole 2.1.x
         line bundles a vulnerable SQLite; no 2.1.x patch exists). 3.x bundles a patched engine and
         satisfies Microsoft.Data.Sqlite.Core's "SQLitePCLRaw.core >= 2.1.11" floor. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Npgsql" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Polly" Version="8.6.6" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
    <PackageReference Include="OpenAI" Version="2.10.0" />
    <PackageReference Include="RestSharp" Version="114.0.0" />
    <PackageReference Include="YoutubeExplode" Version="6.6.0" />
    <!-- Override YoutubeExplode's vulnerable transitive AngleSharp 1.4.0 dependency. -->
    <PackageReference Include="AngleSharp" Version="1.5.2" />
  </ItemGroup>

</Project>
