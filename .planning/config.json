{
  "mode": "yolo",
  "granularity": "coarse",
  "parallelization": true,
  "commit_docs": true,
  "model_profile": "budget",
  "model_overrides": {
    "gsd-planner": "opus",
    "gsd-code-reviewer": "opus",
    "gsd-verifier": "sonnet",
    "gsd-plan-checker": "sonnet"
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "auto_advance": true,
    "_auto_chain_active": false,
    "cross_ai_execution": true,
    "cross_ai_command": "codex exec -m gpt-5.6-terra -c model_reasoning_effort=\"medium\" -s danger-full-access -c approval_policy=\"never\" --color never -",
    "cross_ai_timeout": 1800,
    "plan_review_convergence": true,
    "use_worktrees": false
  }
}
