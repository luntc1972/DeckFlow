@model DeckFlow.Web.Models.WorkflowStepTabsModel
@{
    // WDG-03 (Phase 11 Sweep 9): pre-select the current step server-side so keyboard users
    // have a valid tablist entry point even when JavaScript fails or is disabled.
    // ARIA tablist pattern requires exactly one tab with aria-selected="true" tabindex="0".
    // The model exposes per-step IsComplete/IsEnabled; the natural "current step" is the first
    // enabled step that is not yet complete (the user's next action). If every enabled step is
    // complete, fall back to the first enabled step, then step 1 so the tablist still has a
    // focusable entry point.
    var firstIncomplete = Model.Steps.FirstOrDefault(s => !s.IsComplete && s.IsEnabled);
    var firstEnabled = Model.Steps.FirstOrDefault(s => s.IsEnabled);
    var currentStep = firstIncomplete?.Step ?? firstEnabled?.Step ?? (Model.Steps.Count > 0 ? Model.Steps[0].Step : 0);
}

<div class="prompt-step-nav" role="tablist" aria-label="@Model.AriaLabel">
    @foreach (var step in Model.Steps)
    {
        var cls = step.IsComplete ? "prompt-step-tab is-complete" : "prompt-step-tab";
        if (!step.IsEnabled)
        {
            cls += " is-disabled";
        }

        @* Why no real `disabled` attribute: a disabled button is unfocusable, which dead-ends arrow
           traversal of the tablist at the first incomplete step. `aria-disabled` conveys the state
           without removing it from the roving-tabindex sequence, and the capture-phase guard in
           site.ts swallows activation while it is "true".
           The type/form binding stays unconditional ON PURPOSE: Cut Lab renders step 4 disabled
           server-side and enables it client-side once the deck reaches 100 cards, and that JS only
           flips disabled/aria-disabled — it never restores type or form. Making those conditional
           left the tab looking enabled while submitting nothing (cut-lab-export.spec.ts:141).
           aria-label: the visible label span is display:none below 600px (site-mobile.css) while
           the number span is aria-hidden, so without this the tab is an unnamed button on phones. *@
        <button type="@(step.SubmitFormId is null ? "button" : "submit")"
                class="@cls"
                role="tab"
                id="@($"{Model.TabIdPrefix}-{step.Step}")"
                aria-controls="@($"{Model.PanelIdPrefix}-{step.Step}")"
                aria-selected="@(step.Step == currentStep ? "true" : "false")"
                tabindex="@(step.Step == currentStep ? "0" : "-1")"
                aria-disabled="@(!step.IsEnabled ? "true" : "false")"
                aria-label="@step.Label"
                form="@step.SubmitFormId"
                data-@(Model.DataShowStepAttribute)="@step.Step"><span class="prompt-step-tab__num" aria-hidden="true">@step.Step</span><span class="prompt-step-tab__label">@step.Label</span></button>
    }
</div>
