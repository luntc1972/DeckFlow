@model DeckFlow.Web.Models.Admin.AdminAnalyticsViewModel
@{
    ViewData["Title"] = "Analytics";
    ViewData["Heading"] = "Page-usage analytics";
    ViewData["Lede"] = "Page-view and traffic analytics over time.";
}

<noscript>
    <meta http-equiv="refresh" content="60" />
</noscript>

@section PageActions
{
    <nav class="admin-filter-chips" aria-label="Time range">
        <a href="@Url.Action("Index", new { range = "today" })" class="admin-filter-chips__chip @(Model.Range == "today" ? "is-active" : "")" aria-current="@(Model.Range == "today" ? "true" : null)">Today</a>
        <a href="@Url.Action("Index", new { range = "7d" })" class="admin-filter-chips__chip @(Model.Range == "7d" ? "is-active" : "")" aria-current="@(Model.Range == "7d" ? "true" : null)">Last 7 days</a>
        <a href="@Url.Action("Index", new { range = "30d" })" class="admin-filter-chips__chip @(Model.Range == "30d" ? "is-active" : "")" aria-current="@(Model.Range == "30d" ? "true" : null)">Last 30 days</a>
        <a href="@Url.Action("Index", new { range = "all" })" class="admin-filter-chips__chip @(Model.Range == "all" ? "is-active" : "")" aria-current="@(Model.Range == "all" ? "true" : null)">All time</a>
    </nav>
}

<section class="admin-card" data-admin-analytics aria-label="Top routes">

    @if (Model.Routes.Count == 0)
    {
        <p class="admin-empty">No request metrics recorded yet for this window.</p>
    }
    else
    {
        <div class="admin-table-scroll" role="region" aria-label="Page analytics - scroll horizontally to see all columns" tabindex="0">
            <table class="admin-table admin-analytics-table">
                <caption class="sr-only">Top routes by hit count with unique IPs, error rate, and 14-day hit sparkline.</caption>
                <thead>
                    <tr>
                        <th scope="col" class="route">Route</th>
                        <th scope="col" class="num">Hits</th>
                        <th scope="col" class="num">Unique IPs</th>
                        <th scope="col" class="num">Error rate</th>
                        <th scope="col" class="spark">Last 14 days</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Routes)
                {
                    <tr>
                        <td class="route"><code>@row.RouteKey</code></td>
                        <td class="num">@row.Hits.ToString("N0")</td>
                        <td class="num">@row.UniqueIps.ToString("N0")</td>
                        <td class="num">@DeckFlow.Web.Models.Admin.AdminAnalyticsViewModel.FormatErrorRate(row.ErrorRate)</td>
                        <td class="spark admin-sparkline">@Html.Raw(DeckFlow.Web.Models.Admin.AdminAnalyticsViewModel.RenderSparkline(row.HitsByDay))</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts
{
    <script src="~/js/admin-analytics.js" asp-append-version="true"></script>
}
