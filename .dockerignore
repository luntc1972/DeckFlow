**/bin/
**/obj/
**/.vs/
**/.vscode/
**/node_modules/
**/*.user
**/logs/
**/TestResults/

# Git metadata
.git/
.gitignore
.gitattributes

# Local planning / notes / dev tooling not needed for the image
.planning/
.claude/
# browser-extensions/ is intentionally NOT ignored: the ZipDeckFlowBridge MSBuild
# target zips browser-extensions/deckflow-bridge into
# wwwroot/extensions/deckflow-bridge.zip during publish (served at
# /extensions/deckflow-bridge.zip). Excluding it from the build context makes the
# target's Exists() condition false in-container, so the zip is never built and the
# production download 404s. Only /app/publish reaches the runtime image, so keeping
# the source in the build context does not bloat the final image.
docs/
prompt-templates/
scripts/
tasks/

# Test projects (Dockerfile only copies what it needs; this is belt-and-suspenders)
DeckFlow.Core.Tests/
DeckFlow.Web.Tests/

# Artifacts directory — should be a volume at runtime, not baked into the image
artifacts/

# Host OS files
Dockerfile
.dockerignore
README.md
*.md
!content-kb/
!content-kb/**
!content-kb/**/*.md
