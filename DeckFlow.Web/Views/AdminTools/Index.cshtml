@using DeckFlow.Web.Services.Tools
@model DeckFlow.Web.Controllers.Admin.AdminToolsListViewModel
@{
    ViewData["Title"] = "Tools";
    ViewData["Lede"] = "Turn public tools on or off; cascades to home tile, nav, help, and route.";
    var actionMessage = TempData["AdminToolsAction"] as string;
    var warningMessage = TempData["AdminToolsWarning"] as string;
    var toolCount = Model.Sections.Sum(section => section.Tools.Count);
}

<section class="admin-tools">
    @if (!string.IsNullOrEmpty(actionMessage))
    {
        <div class="admin-banner admin-banner--success">@actionMessage</div>
    }

    @if (Model.DisabledCoreToolLabels.Count > 0)
    {
        <div class="admin-banner admin-banner--warn" role="status">
            <strong>Core Analyze workflow warning.</strong>
            @if (!string.IsNullOrEmpty(warningMessage))
            {
                <span>@warningMessage</span>
            }
            else
            {
                <span>These core tools are currently hidden.</span>
            }
            <span>Disabled core tools: @string.Join(", ", Model.DisabledCoreToolLabels).</span>
        </div>
    }

    @if (toolCount > 0)
    {
        <div class="admin-filter hidden" data-tools-filter>
            <div class="admin-field admin-filter-search">
                <label for="tools-filter-search">Filter by tool name or flag key prefix</label>
                <input id="tools-filter-search" type="search" autocomplete="off" placeholder="e.g. cut or tool.cut" aria-controls="tools-sections" />
            </div>
            <div class="admin-filter-chips" role="group" aria-label="Status filter">
                <button type="button" class="admin-filter-chips__chip is-active" data-tools-status="" aria-pressed="true">All statuses</button>
                <button type="button" class="admin-filter-chips__chip" data-tools-status="on" aria-pressed="false">Enabled</button>
                <button type="button" class="admin-filter-chips__chip" data-tools-status="off" aria-pressed="false">Disabled</button>
            </div>
            <p class="admin-filter__count" id="tools-filter-count" role="status" aria-live="polite"></p>
        </div>
    }

    <div class="admin-stack" id="tools-sections">
        @foreach (var toolSection in Model.Sections)
        {
            <section class="admin-card" data-tools-section aria-labelledby="tools-@toolSection.Section-heading">
            <h2 class="admin-card__title" id="tools-@toolSection.Section-heading">@toolSection.Section</h2>
            <table class="admin-table admin-table--card">
                <caption class="sr-only">@toolSection.Section tools and their current on/off status</caption>
                <thead>
                    <tr>
                        <th scope="col">Tool</th>
                        <th scope="col">Flag</th>
                        <th scope="col">Status</th>
                        <th scope="col">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tool in toolSection.Tools)
                    {
                        <tr data-tool-label="@tool.Label" data-tool-flag-key="@tool.FlagKey" data-tool-enabled="@(tool.Enabled ? "true" : "false")">
                            <td data-label="Tool">
                                <span>@tool.Label</span>
                                @if (tool.Core)
                                {
                                    <span class="admin-tools__core-badge">Core</span>
                                }
                            </td>
                            <td data-label="Flag"><code>@tool.FlagKey</code></td>
                            <td data-label="Status">@(tool.Enabled ? "On" : "Off")</td>
                            <td data-label="Action">
                                <form method="post" action="@Url.Content($"~/Admin/Tools/{tool.FlagKey}/toggle")" class="admin-action-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="enabled" value="@((!tool.Enabled).ToString().ToLowerInvariant())" />
                                    <button type="submit">@(tool.Enabled ? "Disable" : "Enable")</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </section>
        }
        <p class="admin-filter__empty hidden" id="tools-filter-empty">No tools match the current filter.</p>
    </div>
</section>

@section Scripts {
    <script src="~/js/flag-filter.js" asp-append-version="true"></script>
    <script src="~/js/admin-tools.js" asp-append-version="true"></script>
}
