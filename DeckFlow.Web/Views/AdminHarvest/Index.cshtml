@model DeckFlow.Web.Models.Admin.AdminHarvestViewModel
@using System.Globalization
@using DeckFlow.Web.Services.Harvest
@{
    ViewData["Title"] = "Harvest";
    var activeState = Model.ActiveRun?.State.ToString() ?? "Idle";

    static string FormatBytes(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        double value = bytes;
        var unitIndex = 0;
        while (value >= 1024 && unitIndex < units.Length - 1)
        {
            value /= 1024;
            unitIndex++;
        }

        return $"{value:0.##} {units[unitIndex]}";
    }

    static string FormatLastProcessedUtc(string? lastProcessedUtc)
    {
        if (string.IsNullOrWhiteSpace(lastProcessedUtc))
        {
            return "—";
        }

        return DateTimeOffset.TryParse(
            lastProcessedUtc,
            CultureInfo.InvariantCulture,
            DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal,
            out var parsed)
            ? parsed.UtcDateTime.ToString("u", CultureInfo.InvariantCulture)
            : lastProcessedUtc;
    }
}

<noscript>
    <meta http-equiv="refresh" content="5" />
</noscript>

@if (!string.IsNullOrEmpty(Model.LastBanner))
{
    <div class="admin-banner admin-banner--success">@Model.LastBanner</div>
}

<section class="admin-harvest__panel">
    <h2>Run Now</h2>
    <form method="post" asp-action="RunNow" class="admin-action-form">
        @Html.AntiForgeryToken()
        <label for="durationSeconds">Duration</label>
        <select id="durationSeconds" name="durationSeconds">
            @foreach (var durationSeconds in Model.DurationOptions)
            {
                var minutes = durationSeconds / 60;
                <option value="@durationSeconds" selected="@(durationSeconds == 3600 ? "selected" : null)">@minutes minutes</option>
            }
        </select>
        <button type="submit">Run Now</button>
    </form>

    @if (Model.ActiveRun is not null)
    {
        <form method="post" asp-action="Cancel" asp-route-jobId="@Model.ActiveRun.Id" class="admin-action-form">
            @Html.AntiForgeryToken()
            <button type="submit">Cancel</button>
        </form>
    }

    <div id="harvest-status-live" role="status" aria-live="polite" data-harvest-status data-state="@activeState">
        <strong>Status:</strong> <span class="admin-harvest__state">@activeState</span>
        @if (Model.ActiveRun is not null)
        {
            <span> | Decks: <span class="admin-harvest__decks">@Model.ActiveRun.DecksProcessed</span></span>
            <span> | Started: <span class="admin-harvest__started">@(Model.ActiveRun.StartedUtc?.ToString("u") ?? "Queued")</span></span>
            <span> | Elapsed: <span class="admin-harvest__elapsed">—</span></span>
        }
        else
        {
            <span> | Decks: <span class="admin-harvest__decks">0</span></span>
            <span> | Started: <span class="admin-harvest__started">—</span></span>
            <span> | Elapsed: <span class="admin-harvest__elapsed">—</span></span>
        }
    </div>
</section>

<section class="admin-harvest__panel">
    <h2>Single URL</h2>
    <form method="post" asp-action="SubmitUrl" class="admin-action-form">
        @Html.AntiForgeryToken()
        <label for="url">Archidekt URL</label>
        <input id="url" type="url" name="url" autocomplete="url" inputmode="url" placeholder="https://archidekt.com/decks/…" required />
        <button type="submit">Submit</button>
    </form>
</section>

<section class="admin-harvest__panel">
    <h2>Schedule</h2>
    <form method="post" asp-action="SaveSchedule" class="admin-action-form">
        @Html.AntiForgeryToken()
        <label for="intervalHours">Interval</label>
        <select id="intervalHours" name="intervalHours">
            <option value="">Off</option>
            @foreach (var intervalHours in Model.IntervalOptions)
            {
                <option value="@intervalHours" selected="@(Model.Schedule.IntervalHours == intervalHours ? "selected" : null)">Every @intervalHours hours</option>
            }
        </select>
        <input type="hidden" name="paused" value="@(Model.Schedule.Paused.ToString().ToLowerInvariant())" />
        <button type="submit">Save</button>
    </form>

    <form method="post" asp-action="PauseSchedule" class="admin-action-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="paused" value="@((!Model.Schedule.Paused).ToString().ToLowerInvariant())" />
        <button type="submit">@(Model.Schedule.Paused ? "Resume" : "Pause")</button>
    </form>

    <p>Current interval: @(Model.Schedule.IntervalHours?.ToString() ?? "Off")</p>
    <p>Paused: @(Model.Schedule.Paused ? "Yes" : "No")</p>
</section>

<section class="admin-harvest__panel">
    <h2>Stats</h2>
    @if (Model.Stats is null)
    {
        <p>Stats unavailable.</p>
    }
    else
    {
        <p>Total decks: @Model.Stats.TotalDecks (@Model.Stats.TotalDecks30d in last 30 days)</p>
        <p>Total observations: @Model.Stats.TotalObservations</p>
        <p>Storage size: @(Model.Stats.PostgresStorageBytes is long b ? FormatBytes(b) : "N/A")</p>
        <p>Last successful run: @(Model.Stats.LastSuccessUtc?.ToString("yyyy-MM-dd HH:mm UTC") ?? "Never")</p>
        <p>Next scheduled run: @(Model.Stats.NextScheduledUtc?.ToString("yyyy-MM-dd HH:mm UTC") ?? "Off")</p>
        <p>Decks Processed counts written decks (added + updated); unchanged cache hits are skipped to reduce write churn.</p>
    }

    @if (Model.Stats?.RecentRuns.Count > 0)
    {
        <h3>Recent Runs</h3>
        <div class="admin-table-scroll" role="region" aria-label="Recent harvest runs - scroll horizontally to see all columns" tabindex="0">
            <table class="admin-table">
                <caption class="sr-only">Recent harvest runs with start, completion, state, and decks processed</caption>
                <thead>
                    <tr>
                        <th scope="col">Started</th>
                        <th scope="col">Completed</th>
                        <th scope="col">State</th>
                        <th scope="col">Decks Processed</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var run in Model.Stats.RecentRuns)
                    {
                        <tr>
                            <td>@(run.StartedUtc?.ToString("u") ?? run.RequestedUtc.ToString("u"))</td>
                            <td>@(run.CompletedUtc?.ToString("u") ?? "—")</td>
                            <td>@run.State</td>
                            <td>@run.DecksProcessed</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Model.RecentRuns.Count == 0)
    {
        <p>No runs recorded yet.</p>
    }
    else
    {
        <h3>Run Log</h3>
        <div class="admin-table-scroll" role="region" aria-label="Harvest run log - scroll horizontally to see all columns" tabindex="0">
            <table class="admin-table">
                <caption class="sr-only">Harvest run log with timing, state, deck counts, and any error message</caption>
                <thead>
                    <tr>
                        <th scope="col">Started</th>
                        <th scope="col">Kind</th>
                        <th scope="col">State</th>
                        <th scope="col">Decks</th>
                        <th scope="col">Duration</th>
                        <th scope="col">Error</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var run in Model.RecentRuns)
                    {
                        <tr>
                            <td>@(run.StartedUtc?.ToString("u") ?? run.RequestedUtc.ToString("u"))</td>
                            <td>@run.Kind</td>
                            <td>@run.State</td>
                            <td>@run.DecksProcessed</td>
                            <td>@run.DurationSeconds</td>
                            <td>@(run.ErrorMessage ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</section>

<section id="harvested-commanders" class="admin-harvest__panel">
    <h2>Harvested Commanders</h2>
    <p>@Model.DeckTotalCount commanders - Page @Model.DeckPage of @Model.DeckTotalPages</p>

    @if (Model.HarvestedCommanders.Count == 0)
    {
        <p>No harvested commanders yet.</p>
    }
    else
    {
        <div class="admin-table-scroll" role="region" aria-label="Harvested commanders - scroll horizontally to see all columns" tabindex="0">
            <table class="admin-table">
                <caption class="sr-only">Harvested commanders with deck count and last processed timestamp</caption>
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Commander</th>
                        <th scope="col">Decks Categorized</th>
                        <th scope="col">Last Processed (UTC)</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var rankOffset = (Model.DeckPage - 1) * Model.DeckPageSize;
                    }
                    @for (var i = 0; i < Model.HarvestedCommanders.Count; i++)
                    {
                        var c = Model.HarvestedCommanders[i];
                        <tr>
                            <td>@(rankOffset + i + 1)</td>
                            <td>@c.CommanderName</td>
                            <td>@c.DeckCount</td>
                            <td>@FormatLastProcessedUtc(c.LastProcessedUtc)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <nav class="admin-feedback-pagination">
            @if (Model.DeckPage > 1)
            {
                <a asp-action="Index" asp-route-page="@(Model.DeckPage - 1)" asp-fragment="harvested-commanders">Prev</a>
            }
            <span>Page @Model.DeckPage of @Model.DeckTotalPages</span>
            @if (Model.DeckPage < Model.DeckTotalPages)
            {
                <a asp-action="Index" asp-route-page="@(Model.DeckPage + 1)" asp-fragment="harvested-commanders">Next</a>
            }
        </nav>
    }
</section>

@section Scripts
{
    <script src="~/js/admin-harvest.js" asp-append-version="true"></script>
}
