@model DeckFlow.Web.Models.DeckAnalysisViewModel
@using DeckFlow.Core.Analysis
@using DeckFlow.Web.Configuration
@using DeckFlow.Web.Services.Tools
@using Microsoft.Extensions.Options
@inject IOptions<AiPlatformOptions> AiPlatformOptionsAccessor
@inject DeckFlow.Web.Services.FeatureFlags.IFeatureFlagCache FlagCache
@{
    ViewData["Title"] = "MTG Commander Deck Analysis for ChatGPT";
    ViewData["Description"] = "Get a structured review of your Commander deck — strengths, weaknesses, and upgrade paths. One-paste prompt workflow for ChatGPT or Claude.";
    var aiPlatform = AiPlatform.Normalize(Model.Request.TargetAiPlatform);
    var platformList = AiPlatformCopy.PlatformList(AiPlatformOptionsAccessor.Value.GeminiEnabled);
    var currentStep = Math.Clamp(Model.Request.WorkflowStep, 1, 5);
    var commanderBrackets = DeckFlow.Web.Models.CommanderBracketCatalog.Options;
    var questionBuckets = DeckFlow.Web.Models.AnalysisQuestionCatalog.Buckets;
    var analysisFollowUpPrompt = """
Answer my follow-up questions first.

Then regenerate the full updated deck_profile JSON so it reflects:
- your latest conclusions and corrections
- the additional questions I asked directly in chat
- the answers you gave to those additional questions

Update the question_answers array so it includes those additional direct-chat questions and answers in the correct order alongside the original requested questions.

Return only the updated deck_profile inside a fenced ```json code block.
Do not omit any fields from the schema.
""";
    var setUpgradeFollowUpPrompt = """
Answer my follow-up questions first.

Then regenerate the full updated set_upgrade_report JSON so it reflects:
- your latest conclusions and corrections
- the additional questions I asked directly in chat
- the answers you gave to those additional questions

Return only the updated set_upgrade_report inside a fenced ```json code block.
Do not omit any fields from the schema.
""";
    var selectedQuestionSet = new HashSet<string>(Model.Request.SelectedAnalysisQuestions, StringComparer.OrdinalIgnoreCase);
    var openBuckets = new HashSet<string>(
        DeckFlow.Web.Models.AnalysisQuestionCatalog.Buckets
            .Where(b => b.Questions.Any(q => selectedQuestionSet.Contains(q.Id)))
            .Select(b => b.Id),
        StringComparer.OrdinalIgnoreCase);
    // Prefer the exact Scryfall rules text from the generated set packet; fall back to the
    // AI-echoed card_text when the packet was unavailable for this session.
    Func<DeckFlow.Web.Models.SetUpgradeTopAdd, string> resolveCardText = add =>
        Model.SetUpgradeCardText.TryGetValue(add.Card, out var packetText) && !string.IsNullOrWhiteSpace(packetText)
            ? packetText
            : add.CardText;
    // Coarse assembly-speed label for a WinConBand; never a turn-number claim (WINCON-03 hedge).
    // Shared Core formatter so the prompt artifact and this readout can't drift.
    Func<WinConBand, string> formatWinConBand = WinConBandFormatter.Label;
}

<section class="hero">
    <h1>Deck Analysis</h1>
    <p class="page-lede">Generate a prompt to paste into @platformList.</p>
    <p class="lede">Paste your deck, choose your analysis questions, generate the prompt, and paste back the results. The set-upgrade step is optional.</p>
</section>

@await Html.PartialAsync("_BusyIndicator")
@await Html.PartialAsync("_DeckToolTabs", Model.ActiveTab)

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="error-banner" role="alert">@Model.ErrorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ImportWarning))
{
    <div class="warning-banner" role="status">@Model.ImportWarning</div>
}

@if (!string.IsNullOrWhiteSpace(Model.TimingSummary))
{
    <details class="timing-summary">
        <summary>Generation timing</summary>
        <pre>@Model.TimingSummary</pre>
    </details>
}

<div class="error-banner hidden" data-prompt-validation-error role="alert"></div>

<div class="toolbar prompt-page-toolbar desktop-only">
    <div class="prompt-layout-picker" role="group" aria-label="Workflow layout" data-prompt-ui-mode-picker>
        <span class="prompt-layout-picker__label">Layout</span>
        <div class="prompt-layout-picker__segments">
            <button type="button" class="prompt-layout-segment" data-prompt-ui-mode-button="guided" title="Full workflow — all guidance text">Full</button>
            <button type="button" class="prompt-layout-segment" data-prompt-ui-mode-button="focused" title="Compact workflow — reduced guidance">Compact</button>
            <button type="button" class="prompt-layout-segment" data-prompt-ui-mode-button="expert" title="Advanced workflow — minimal guidance">Advanced</button>
        </div>
    </div>
</div>

<form method="post" action="@Url.Content("~/deck-analysis")" class="deck-form prompt-packets-form" data-print-region="workflow" data-cache-key="prompt-packets" data-prompt-packets-form data-prompt-current-step="@currentStep" data-prompt-ui-mode="guided" data-set-options-url="@Url.Content("~/api/set-options")" data-busy-title="Building Deck Analysis Packet" data-busy-message="Resolving the deck and generating prompt files.">
    <div class="prompt-sticky-download" role="region" aria-label="Save current session">
        <span class="prompt-sticky-download__label">Save your work in progress to a zip file you can re-import later.</span>
        <button type="submit" class="run-button prompt-sticky-download__button" data-no-busy data-prompt-download-submit
                formaction="@Url.Content("~/deck-analysis/download")"
                formmethod="post"
                formnovalidate>
            Download session (.zip)
        </button>
    </div>
    @Html.AntiForgeryToken()
    <input type="hidden" name="WorkflowStep" value="@currentStep" data-prompt-workflow-step />
    <details class="prompt-resume" data-prompt-resume>
        <summary>Resume from a saved session (.zip)</summary>
        <p class="sync-column__hint">
            Choose a <code>.zip</code> file you previously downloaded from Step 3 or Step 5.
            This rehydrates the response JSON and jumps to the matching results step.
        </p>
        <label class="field">
            <span>Saved session file</span>
            <input type="file" name="zipFile" accept=".zip,application/zip"
                   data-prompt-zip-upload
                   data-upload-action="@Url.Content("~/deck-analysis/upload")" />
        </label>
        <button type="submit"
                class="run-button"
                data-prompt-upload-submit
                formaction="@Url.Content("~/deck-analysis/upload")"
                formenctype="multipart/form-data"
                formmethod="post"
                formnovalidate>
            Upload &amp; Resume
        </button>
    </details>

    @{
        var packetTabs = new DeckFlow.Web.Models.WorkflowStepTabsModel(
            AriaLabel: "Deck Analysis packet workflow steps",
            TabIdPrefix: "prompt-step-tab",
            PanelIdPrefix: "prompt-step-panel",
            DataShowStepAttribute: "prompt-show-step",
            Steps: new[]
            {
                new DeckFlow.Web.Models.WorkflowStepTab(1, "Step 1: Deck", !string.IsNullOrWhiteSpace(Model.Request.DeckSource)),
                // Steps 2/4 stay complete once their downstream response exists (the service
                // returns null prompt text on steps 3/5 where the deck load is skipped); the
                // completeness rule lives on the view model so it stays unit-tested.
                new DeckFlow.Web.Models.WorkflowStepTab(2, "Step 2: Build Analysis Prompt", Model.IsAnalysisPromptStepComplete),
                new DeckFlow.Web.Models.WorkflowStepTab(3, "Step 3: Analysis Results", Model.AnalysisResponse is not null),
                new DeckFlow.Web.Models.WorkflowStepTab(4, "Step 4: Build Set Upgrade Prompt", Model.IsSetUpgradePromptStepComplete),
                new DeckFlow.Web.Models.WorkflowStepTab(5, "Step 5: Set Upgrade Results", Model.SetUpgradeResponse is not null)
            });
    }
    @await Html.PartialAsync("_WorkflowStepTabs", packetTabs)
    <section class="result-panel prompt-step-panel prompt-workflow-setup" role="tabpanel" id="prompt-step-panel-1" aria-labelledby="prompt-step-tab-1" data-prompt-step="1" data-prompt-setup-panel>
        <div class="prompt-step-heading">
            <div>
                <p class="prompt-step-eyebrow">Step 1</p>
                <h2>Paste the deck once for the whole workflow</h2>
                <p>This deck input powers the analysis packet and the optional set-upgrade packet.</p>
            </div>
            <span class="prompt-step-badge">Required</span>
        </div>

        <div class="sync-column__body">
            <label class="field">
                <span>Input method</span>
                <select name="DeckInputSource" data-df-select>
                    <option value="@DeckFlow.Web.Models.DeckInputSource.PasteText" selected="@(Model.Request.DeckInputSource == DeckFlow.Web.Models.DeckInputSource.PasteText)">Paste text</option>
                    <option value="@DeckFlow.Web.Models.DeckInputSource.PublicUrl" selected="@(Model.Request.DeckInputSource == DeckFlow.Web.Models.DeckInputSource.PublicUrl)">Use public deck URL</option>
                </select>
            </label>
            <label class="field sync-column__input-field @(Model.Request.DeckInputSource == DeckFlow.Web.Models.DeckInputSource.PublicUrl ? string.Empty : "hidden")" data-sync-panel="prompt-deck-url">
                <span>Public deck URL</span>
                <input type="url" name="DeckUrl" value="@Model.Request.DeckUrl" autocomplete="url" inputmode="url" placeholder="https://moxfield.com/decks/… or https://archidekt.com/decks/…" />
                <small class="sync-column__hint">Required. Paste a public Moxfield or Archidekt deck URL.</small>
                @await Html.PartialAsync("_DeckFlowBridgeHint")
            </label>
            <label class="field sync-column__input-field @(Model.Request.DeckInputSource == DeckFlow.Web.Models.DeckInputSource.PasteText ? string.Empty : "hidden")" data-sync-panel="prompt-deck-text">
                <span>Deck export text</span>
                <textarea autocomplete="off" name="DeckText" spellcheck="false">@Model.Request.DeckText</textarea>
                <small class="sync-column__hint">Required. Paste Moxfield, Archidekt, or MTG Arena deck export text directly.</small>
                @await Html.PartialAsync("_MoxfieldBulkEditHint", "Run Analysis")
            </label>
        </div>
        @if (Model.CommandZoneAwarenessEnabled)
        {
            <details class="deck-analysis-overrides">
                <summary>Companion (optional)</summary>
                <div class="field">
                    <label for="deck-analysis-companion-name">Companion name</label>
                    <p class="sync-column__hint" id="deck-analysis-companion-hint">Auto-detected from Moxfield; name it here for Archidekt or pasted lists, or to override.</p>
                    <input id="deck-analysis-companion-name" type="text" name="CompanionName" spellcheck="false" autocomplete="off"
                           placeholder="e.g. Jegantha, the Wellspring…" value="@Model.Request.CompanionName" aria-describedby="deck-analysis-companion-hint" />
                </div>
            </details>
        }
        <div class="toolbar prompt-step-actions">
            <button type="button" class="clear-cache-button" data-clear-cache data-clear-href="@Url.Content("~/deck-analysis")">Start Over</button>
            <div class="prompt-step-note">You only need to paste the deck here once. After that, move through the workflow tabs below.</div>
            <button type="button" class="run-button" data-prompt-next-step="2" data-default-action>Next: Analysis</button>
        </div>
    </section>

    <section class="result-panel prompt-step-panel" role="tabpanel" id="prompt-step-panel-2" aria-labelledby="prompt-step-tab-2" data-prompt-step="2">
        <div class="prompt-step-heading">
            <div>
                <p class="prompt-step-eyebrow">Step 2</p>
                <h2>Choose the analysis questions and generate the analysis packet</h2>
                <p>Select the Commander bracket you want to target, then choose the question buckets or individual questions that should be answered in the analysis prompt.</p>
            </div>
            <span class="prompt-step-badge">Customize the analysis</span>
        </div>
        @await Html.PartialAsync("_AiSelector", Model.Request.TargetAiPlatform)
        <div class="prompt-instructions">
            <strong>What you do:</strong>
            <ol>
                <li>Choose the target Commander bracket.</li>
                <li>Select question buckets, individual questions, or both.</li>
                <li>Optional: include sideboard/maybeboard cards as candidate references.</li>
                <li>Click <code>Generate Analysis Packet</code>, then copy <code>analysis.txt</code> into your AI.</li>
                <li>Ask your AI to return the <code>deck_profile</code> JSON in a fenced <code>```json</code> block.</li>
                <li>Paste that JSON in Step 3 for a formatted summary. (Step 4 set upgrades is optional.)</li>
            </ol>
            <p><strong>Knowledge Base note:</strong> Browse distilled creator advice in the <a href="@Url.Content("~/content-kb")">Knowledge Base</a>, then open any entry to copy a ready-to-paste prompt from its detail page.</p>
        </div>

        <details class="info-banner prompt-helper-panel">
            <summary><strong>How to push back on your AI's conclusions</strong></summary>
            <p>If your AI makes a bad assumption, challenge the specific conclusion before you paste the <code>deck_profile</code> JSON back here. Ask it to revise the analysis and return an updated <code>deck_profile</code> JSON that reflects your corrections.</p>
            <p>Examples: "Re-evaluate this as Bracket 2 Core, not Bracket 3 Upgraded." "You overstated the combo finishers; the deck wins primarily through combat." "Card X is not a weak slot because it is part of the recursion engine."</p>
            <p>Best practice: keep the conversation with your AI going until the analysis reflects your corrections, then copy only the latest corrected <code>deck_profile</code> JSON into Step 3.</p>
        </details>

        <details class="result-panel nested-panel">
            <summary>Optional follow-up JSON refresh prompt</summary>
            <div class="panel-heading">
                <div>
                    <p>Use this later only if you asked additional questions of your AI after the first analysis response and need it to rebuild the updated <code>deck_profile</code> JSON.</p>
                </div>
                <button type="button" class="copy-button" data-copy-target="analysis-follow-up-output">Copy</button>
            </div>
            <textarea autocomplete="off" id="analysis-follow-up-output" readonly spellcheck="false">@analysisFollowUpPrompt</textarea>
        </details>

        <div class="bracket-callout">
            <p class="bracket-callout__label">Required before generating</p>
            <label class="field">
                <span>Target Commander bracket <small>(required)</small></span>
                <select name="TargetCommanderBracket" required aria-required="true" data-df-select>
                    <option value="">Select a target bracket (required)</option>
                    @foreach (var bracket in commanderBrackets)
                    {
                        <option value="@bracket.Value" selected="@(string.Equals(Model.Request.TargetCommanderBracket, bracket.Value, StringComparison.OrdinalIgnoreCase))">@bracket.Label</option>
                    }
                </select>
                <small class="sync-column__hint">Required. The analysis prompt will include the official Commander bracket expectation and turn pacing for the bracket you select.</small>
            </label>
        </div>
        <details class="result-panel nested-panel" open>
            <summary>Analysis context</summary>
            <div class="prompt-context-note">
                <p>These fields do not change the deck parser. They are extra instructions that get inserted into the analysis and set-upgrade prompts.</p>
                <ul>
                    <li><strong>Format</strong> keeps the analysis and upgrade prompts in the right rules context.</li>
                    <li><strong>Deck name</strong> gives the prompts a stable label and is also saved with the packet artifacts.</li>
                    <li><strong>Strategy notes</strong> tell your AI what the deck is trying to do so it weighs the list against your intended game plan.</li>
                    <li><strong>Meta notes</strong> tell your AI what kinds of tables or threats you expect, which changes how it judges weaknesses and upgrades.</li>
                </ul>
                <p>If you leave these blank, the prompts still work. Your AI will infer more from the decklist alone.</p>
            </div>
            <div class="sync-columns">
                <label class="field">
                    <span>Format</span>
                    <input type="text" name="Format" value="@Model.Request.Format" />
                </label>
                <label class="field">
                    <span>Deck name</span>
                    <input type="text" name="DeckName" value="@Model.Request.DeckName" />
                </label>
            </div>
            <label class="field">
                <span>Strategy notes</span>
                <textarea autocomplete="off" name="StrategyNotes" spellcheck="false">@Model.Request.StrategyNotes</textarea>
            </label>
            <label class="field">
                <span>Meta notes</span>
                <textarea autocomplete="off" name="MetaNotes" spellcheck="false">@Model.Request.MetaNotes</textarea>
            </label>
        </details>
        <div class="result-panel nested-panel">
            <label class="prompt-question-option">
                <input type="checkbox" name="IncludeCandidateReferencesInAnalysis" value="true" @(Model.Request.IncludeCandidateReferencesInAnalysis ? "checked" : "") />
                <span>Include sideboard/maybeboard cards as candidate references in the analysis prompt</span>
            </label>
            <small class="sync-column__hint">Current-deck card definitions are always included. These options only add authoritative references for optional candidate cards and keep them labeled as candidates, not active deck cards.</small>
        </div>
        <section class="prompt-question-picker">
            <div class="prompt-question-picker__header">
                <h3>Analysis questions</h3>
                <p>Select a whole bucket to check all questions under it, or choose individual questions manually.</p>
            </div>
            <div class="prompt-question-buckets">
                @foreach (var bucket in questionBuckets)
                {
                    var bucketId = $"bucket-{bucket.Id}";
                    var bucketOpen = openBuckets.Contains(bucket.Id);
                    var bucketAriaExpanded = bucketOpen ? "true" : "false";
                    var bucketQuestionsClass = bucketOpen ? "prompt-question-bucket__questions" : "prompt-question-bucket__questions hidden";
                    <section class="result-panel nested-panel prompt-question-bucket">
                        <div class="prompt-question-bucket__header">
                            <label class="prompt-question-bucket__label">
                                <input type="checkbox" data-question-bucket="@bucket.Id" id="@bucketId" />
                                <span>@bucket.Label</span>
                            </label>
                            <button type="button" class="prompt-question-bucket__toggle" data-bucket-toggle="@bucket.Id" aria-expanded="@bucketAriaExpanded" aria-label="Toggle @bucket.Label questions"></button>
                        </div>
                        <div class="@bucketQuestionsClass" data-bucket-questions="@bucket.Id">
                            @foreach (var question in bucket.Questions)
                            {
                                <label class="prompt-question-option">
                                    <input
                                        type="checkbox"
                                        name="SelectedAnalysisQuestions"
                                        value="@question.Id"
                                        data-question-option="@bucket.Id"
                                        checked="@(Model.Request.SelectedAnalysisQuestions.Contains(question.Id, StringComparer.OrdinalIgnoreCase))" />
                                    <span>@question.Text</span>
                                </label>
                            }
                            @if (bucket.Id == "optimization-upgrades")
                            {
                                <label class="field prompt-budget-field hidden" data-budget-question-field>
                                    <span>Budget amount for budget upgrade question</span>
                                    <input type="text" name="BudgetUpgradeAmount" value="@Model.Request.BudgetUpgradeAmount" inputmode="decimal" />
                                    <small class="sync-column__hint">Used when you select "What are the best upgrades under $X budget?" Enter just the amount, for example <code>50</code>.</small>
                                </label>
                            }
                            @if (bucket.Id == "card-level")
                            {
                                <div class="field prompt-card-specific-field hidden" data-card-specific-question-field data-card-picker>
                                    <span class="field-label">Card names for card-specific questions</span>
                                    <div class="card-picker__rows" data-card-picker-rows>
                                        @if (Model.Request.CardSpecificQuestionCardNames.Count == 0)
                                        {
                                            <div class="card-picker__row" data-card-picker-row>
                                                <div class="autocomplete-anchor card-picker__input-shell">
                                                    <input type="text" name="CardSpecificQuestionCardNames" value="" class="card-picker__input" autocomplete="off" data-card-picker-input />
                                                </div>
                                                <button type="button" class="card-picker__add" data-card-picker-add aria-label="Add another card">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" role="img" aria-hidden="true">
                                                        <line x1="12" y1="5" x2="12" y2="19" />
                                                        <line x1="5" y1="12" x2="19" y2="12" />
                                                    </svg>
                                                </button>
                                                <button type="button" class="card-picker__remove hidden" data-card-picker-remove aria-label="Remove this card" hidden>
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" role="img" aria-hidden="true">
                                                        <line x1="5" y1="12" x2="19" y2="12" />
                                                    </svg>
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            @for (var i = 0; i < Model.Request.CardSpecificQuestionCardNames.Count; i++)
                                            {
                                                var isFirst = i == 0;
                                                <div class="card-picker__row" data-card-picker-row>
                                                    <div class="autocomplete-anchor card-picker__input-shell">
                                                        <input type="text" name="CardSpecificQuestionCardNames" value="@Model.Request.CardSpecificQuestionCardNames[i]" class="card-picker__input" autocomplete="off" data-card-picker-input />
                                                    </div>
                                                    <button type="button" class="card-picker__add" data-card-picker-add aria-label="Add another card">
                                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" role="img" aria-hidden="true">
                                                            <line x1="12" y1="5" x2="12" y2="19" />
                                                            <line x1="5" y1="12" x2="19" y2="12" />
                                                        </svg>
                                                    </button>
                                                    <button type="button" class="card-picker__remove @(isFirst ? "hidden" : "")" data-card-picker-remove aria-label="Remove this card" @(isFirst ? "hidden" : null)>
                                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" role="img" aria-hidden="true">
                                                            <line x1="5" y1="12" x2="19" y2="12" />
                                                        </svg>
                                                    </button>
                                                </div>
                                            }
                                        }
                                    </div>
                                    <small class="sync-column__hint">Used when you select "Is [card] worth including?" or "What are better alternatives to [card]?" Questions with <code>[card]</code> are emitted once per card you list here.</small>
                                </div>
                            }
                            @if (bucket.Id == "deck-versioning")
                            {
                                <label class="field">
                                    <span>Decklist export format <small>(required for category questions)</small></span>
                                    <select name="DecklistExportFormat" data-df-select>
                                        <option value="" selected="@(string.IsNullOrEmpty(Model.Request.DecklistExportFormat))">Select export format</option>
                                        <option value="moxfield" selected="@(string.Equals(Model.Request.DecklistExportFormat, "moxfield", StringComparison.OrdinalIgnoreCase))">Moxfield</option>
                                        <option value="archidekt" selected="@(string.Equals(Model.Request.DecklistExportFormat, "archidekt", StringComparison.OrdinalIgnoreCase))">Archidekt</option>
                                    </select>
                                    <small class="sync-column__hint">Choose which deck builder you will paste the generated lists into. When assigning or updating categories, you must choose Moxfield or Archidekt and @aiPlatform.DisplayName should return the decklist in a fenced <code>```text</code> block.</small>
                                </label>
                                @* Why: this control must never be display:none — a hidden checkbox is
                                   not submitted, so a mobile post silently reset IncludeCardVersions to
                                   false and changed the generated prompt without telling the user. Only
                                   the long explanatory copy is desktop-only now; the control itself
                                   renders and binds at every viewport. *@
                                <label class="prompt-question-option">
                                    <input type="checkbox" name="IncludeCardVersions" value="true" @(Model.Request.IncludeCardVersions ? "checked" : "") />
                                    <span>
                                        Include card versions (set code &amp; collector number) for retained cards
                                        <small class="sync-column__hint sync-column__hint--block desktop-only">When checked, the original deck's set code and collector number are provided to @aiPlatform.DisplayName so it can preserve the exact printing for any card kept in a generated deck version.</small>
                                    </span>
                                </label>
                                <label class="field hidden" data-preferred-categories-field>
                                    <span>Preferred category names (optional)</span>
                                    <textarea autocomplete="off" name="PreferredCategories" rows="4" spellcheck="false">@Model.Request.PreferredCategories</textarea>
                                    <small class="sync-column__hint">One category name per line. @aiPlatform.DisplayName will use these names when assigning categories and will only create new ones when none of the preferred names fit.</small>
                                </label>
                                <label class="field">
                                    <span>Protected cards (optional)</span>
                                    <textarea autocomplete="off" name="ProtectedCards" rows="4" spellcheck="false">@Model.Request.ProtectedCards</textarea>
                                    <small class="sync-column__hint">One card name per line. These cards will always be kept in every generated deck version or upgrade path. They may still appear as suggested cuts in the general analysis.</small>
                                </label>
                            }
                        </div>
                    </section>
                }
            </div>
        </section>
        <label class="field">
            <span>Additional freeform question (optional)</span>
            <textarea autocomplete="off" name="FreeformQuestion" rows="3" spellcheck="false" placeholder="Type any additional question or instruction to include in the analysis prompt…">@Model.Request.FreeformQuestion</textarea>
            <small class="sync-column__hint">This question is appended to the list of selected analysis questions in the generated prompt.</small>
        </label>
        <div class="toolbar prompt-step-actions">
            <button type="submit" class="run-button" data-prompt-submit-step="2" data-default-action>Generate Analysis Packet</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.SuggestedChatTitle))
        {
            <section class="result-panel nested-panel">
                <div class="panel-heading">
                    <div>
                        <h3>Suggested @aiPlatform.DisplayName conversation title</h3>
                        <p>Rename your @aiPlatform.DisplayName conversation to this before pasting the prompt.</p>
                    </div>
                    <button type="button" class="copy-button" data-copy-target="suggested-chat-title">Copy</button>
                </div>
                <input id="suggested-chat-title" type="text" readonly value="@Model.SuggestedChatTitle" />
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(Model.InputSummary))
        {
            <section class="result-panel nested-panel summary-panel">
                <h3>Deck Summary</h3>
                <pre class="deck-summary-pre" spellcheck="false">@Model.InputSummary</pre>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(Model.AnalysisPromptText))
        {
            var analysisBytes = System.Text.Encoding.UTF8.GetByteCount(Model.AnalysisPromptText);
            var analysisKb = analysisBytes / 1024d;
            var pasteWarn = aiPlatform.PasteWarningBytes is int cap && analysisBytes > cap;
            <section class="result-panel nested-panel">
                <div class="panel-heading">
                    <div>
                        <h3>analysis.txt</h3>
                        <p>Paste this into @aiPlatform.DisplayName for the main deck analysis. It requests prose analysis plus a structured <code>deck_profile</code> JSON object.</p>
                        <p class="prompt-size-note">Prompt size: ~@analysisKb.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) KB</p>
                        @if (pasteWarn)
                        {
                            <p class="prompt-size-note prompt-size-note--warn" role="status">⚠️ Large prompt — may exceed @aiPlatform.DisplayName's paste limit. ChatGPT and Claude handle this size fine; for @aiPlatform.DisplayName, trim questions or candidate references, or paste in parts.</p>
                        }
                    </div>
                    <div class="panel-heading__actions">
                        <button type="button" class="copy-button" data-copy-target="analysis-output">Copy</button>
                        <button type="button" class="copy-button" data-expand-target="analysis-output" aria-expanded="false">Expand</button>
                    </div>
                </div>
                <textarea class="prompt-artifact-textarea" autocomplete="off" id="analysis-output" readonly spellcheck="false" data-prompt-result-anchor>@Model.AnalysisPromptText</textarea>
                @await Html.PartialAsync("_PromptSplitTip", "deck_profile")
                <div data-kb-clear-pins-on-load hidden></div>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ReferenceText))
        {
            <section class="result-panel nested-panel">
                <div class="panel-heading">
                    <div>
                        <h3>reference.txt</h3>
                        <p>Support context for the analysis prompt. It contains the authoritative card and mechanic references already embedded into <code>analysis.txt</code>, so you usually do not need to paste it into @aiPlatform.DisplayName separately.</p>
                    </div>
                    <div class="panel-heading__actions">
                        <button type="button" class="copy-button" data-copy-target="reference-output">Copy</button>
                        <button type="button" class="copy-button" data-expand-target="reference-output" aria-expanded="false">Expand</button>
                    </div>
                </div>
                <textarea class="prompt-artifact-textarea" autocomplete="off" id="reference-output" readonly spellcheck="false">@Model.ReferenceText</textarea>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(Model.DeckProfileSchemaJson))
        {
            <details class="result-panel nested-panel desktop-only">
                <summary>Show expected JSON format for deck-profile-schema.json</summary>
                <div class="panel-heading">
                    <div>
                        <h3>deck-profile-schema.json</h3>
                        <p>@aiPlatform.DisplayName should return a <code>deck_profile</code> JSON object matching this schema.</p>
                    </div>
                    <button type="button" class="copy-button" data-copy-target="deck-profile-schema-output">Copy</button>
                </div>
                <textarea autocomplete="off" id="deck-profile-schema-output" readonly spellcheck="false">@Model.DeckProfileSchemaJson</textarea>
            </details>
        }

        <div class="prompt-step-footer">
            <button type="button" class="clear-cache-button" data-prompt-show-step="1">Back: Deck Setup</button>
            <button type="button" class="run-button" data-prompt-next-step="3">Next: Analysis Results</button>
        </div>
    </section>

    <section class="result-panel prompt-step-panel" role="tabpanel" id="prompt-step-panel-3" aria-labelledby="prompt-step-tab-3" data-prompt-step="3">
        <div class="prompt-step-heading">
            <div>
                <p class="prompt-step-eyebrow">Step 3</p>
                <h2>Paste the deck profile JSON and view the analysis results</h2>
                <p>Paste the fenced <code>deck_profile</code> JSON block or raw JSON payload returned from @aiPlatform.DisplayName. You can use a saved JSON file here directly without filling out Steps 1 and 2 again.</p>
            </div>
            <span class="prompt-step-badge">Review results</span>
        </div>

        <label class="field">
            <span>Deck profile JSON</span>
            <textarea autocomplete="off" name="DeckProfileJson" spellcheck="false">@Model.Request.DeckProfileJson</textarea>
            <small class="sync-column__hint">Required for rendering the analysis summary and for the optional set-upgrade step. You can paste the fenced <code>```json</code> block directly.</small>
        </label>

        @if (!string.IsNullOrEmpty(Model.Request.ScoreJson))
        {
            @* Round-trips the multi-axis score across the Step-3 re-post; rendered only when present
               so the flag-OFF page stays byte-identical to baseline (no extra field). *@
            <textarea name="ScoreJson" hidden aria-hidden="true" tabindex="-1">@Model.Request.ScoreJson</textarea>
        }
        @if (!string.IsNullOrEmpty(Model.Request.InteractionAuditJson))
        {
            @* Round-trips the interaction audit across Step-3 re-posts and session zip restores; rendered
               only when present so the flag-OFF page stays byte-identical to baseline (no extra field). *@
            <textarea name="InteractionAuditJson" hidden aria-hidden="true" tabindex="-1">@Model.Request.InteractionAuditJson</textarea>
        }
        @if (!string.IsNullOrEmpty(Model.Request.WinConMapJson))
        {
            @* Round-trips the win-condition/combo map across Step-3 re-posts and session zip restores;
               rendered only when present so the flag-OFF page stays byte-identical to baseline (no extra field). *@
            <textarea name="WinConMapJson" hidden aria-hidden="true" tabindex="-1">@Model.Request.WinConMapJson</textarea>
        }

        <div class="toolbar prompt-step-actions">
            <button type="submit" class="run-button" data-prompt-submit-step="3" data-default-action>Render Analysis Summary</button>
        </div>

        @if (Model.AnalysisResponse is not null)
        {
            <section class="result-panel nested-panel summary-panel" data-prompt-result-anchor data-print-result>
                <div class="toolbar prompt-step-actions">
                    <button type="submit" class="run-button" data-no-busy data-prompt-download-submit
                            formaction="@Url.Content("~/deck-analysis/download")"
                            formmethod="post"
                            formnovalidate>
                        Download session (.zip)
                    </button>
                    <button type="button" class="run-button prompt-print-button" data-no-busy data-prompt-print>
                        Print results
                    </button>
                </div>
                <h3>Analysis Summary</h3>
                @if (Model.Score is not null)
                {
                    <div class="prompt-score" role="region" aria-label="Multi-Axis Deck Score">
                        <p class="prompt-score__eyebrow">Deck Score &middot; four coarse bands (0&ndash;5) from your decklist signals</p>
                        <div class="prompt-score-grid">
                            @foreach (var (axisLabel, band, rationale) in new[]
                            {
                                ("POWER", Model.Score.PowerBand, Model.Score.PowerRationale.SignalText),
                                ("SPEED", Model.Score.SpeedBand, Model.Score.SpeedRationale.SignalText),
                                ("CONTROL", Model.Score.ControlBand, Model.Score.ControlRationale.SignalText),
                                ("CONSISTENCY", Model.Score.ConsistencyBand, Model.Score.ConsistencyRationale.SignalText),
                            })
                            {
                                <div class="prompt-score-card"
                                     role="group"
                                     aria-label="@axisLabel score: @band of 5, @MultiAxisScorer.BandLabel(band)">
                                    <div class="prompt-score-label">@axisLabel</div>
                                    <div class="prompt-score-value">@band</div>
                                    <div class="prompt-score-meter" aria-hidden="true">
                                        @for (int pip = 1; pip <= 5; pip++)
                                        {
                                            <span class="prompt-score-pip@(pip <= band ? " prompt-score-pip--filled" : "")"></span>
                                        }
                                    </div>
                                    <div class="prompt-score-band prompt-score-band--@band">@MultiAxisScorer.BandLabel(band)</div>
                                    <div class="prompt-score-rationale">@rationale</div>
                                </div>
                            }
                        </div>
                        <div class="prompt-score-crosscheck prompt-score-crosscheck--@(Model.Score.ScoreAlignsBracket ? "agree" : "diverge")"
                             role="note">
                            <span class="prompt-score-crosscheck__label">@(Model.Score.ScoreAlignsBracket ? "✓ " : "⚠ ")CROSS-CHECK</span>
                            @Model.Score.BracketCrossCheckText
                        </div>
                    </div>
                }
                @if (Model.InteractionAudit is not null)
                {
                    <div class="interaction-audit" role="region" aria-label="Interaction and Answers Audit">
                        <p class="interaction-audit__eyebrow">Interaction and answers audit &middot; DeckFlow automated first pass for the AI to re-verify</p>
                        <div class="interaction-audit-grid">
                            @foreach (var (label, bucket) in new[]
                            {
                                ("Targeted removal", Model.InteractionAudit.TargetedRemoval),
                                ("Board wipes", Model.InteractionAudit.BoardWipes),
                                ("Counterspells", Model.InteractionAudit.Counterspells),
                                ("Protection or recursion", Model.InteractionAudit.ProtectionRecursion),
                                ("Stax or taxation", Model.InteractionAudit.StaxTaxation),
                            })
                            {
                                <section class="interaction-audit-bucket" aria-label="@label">
                                    <h4>@label</h4>
                                    @if (bucket.Confident.Count > 0)
                                    {
                                        <p class="interaction-audit-count">Approximately @bucket.Confident.Sum(card => card.Quantity) confident; verify against your list.</p>
                                        <ul class="interaction-audit-list">
                                            @foreach (var card in bucket.Confident)
                                            {
                                                <li>@(card.Quantity > 1 ? $"{card.Quantity}x " : string.Empty)@card.Name</li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <p class="interaction-audit-empty">No confident cards found by DeckFlow.</p>
                                    }
                                    @if (bucket.Review.Count > 0)
                                    {
                                        <p class="interaction-audit-review">Review: @string.Join(", ", bucket.Review.Select(card => card.Quantity > 1 ? $"{card.Quantity}x {card.Name}" : card.Name))</p>
                                    }
                                </section>
                            }
                        </div>
                        <div class="interaction-audit-gaps@(Model.InteractionAudit.CoverageGaps.Count > 0 ? " interaction-audit-gaps--flagged" : string.Empty)" role="note">
                            <span class="interaction-audit-gaps__label">Coverage gaps to verify</span>
                            @if (Model.InteractionAudit.CoverageGaps.Count > 0)
                            {
                                <ul>
                                    @foreach (var gap in Model.InteractionAudit.CoverageGaps)
                                    {
                                        <li>@gap</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p>None flagged by DeckFlow; verify against your list.</p>
                            }
                        </div>
                    </div>
                }
                @if (Model.WinConMap is not null)
                {
                    <div class="wincon-map" role="region" aria-label="Win Condition and Combo Map">
                        <p class="wincon-map__eyebrow">Win condition and combo map &middot; DeckFlow automated first pass &mdash; the AI must confirm castability, board state, and color access before treating any line below as a live win condition</p>
                        @if (!Model.WinConMap.ComboDataAvailable)
                        {
                            <p class="wincon-map-unavailable">Combo data unavailable (Commander Spellbook did not respond) &mdash; this is not a claim the deck has no win conditions.</p>
                        }
                        else if (Model.WinConMap.Combos.Count == 0)
                        {
                            <p class="wincon-map-unavailable">No combos detected by DeckFlow's combo lookup &mdash; this is not a claim the deck has no win conditions.</p>
                        }
                        else
                        {
                            <p class="wincon-map-count">Approximately @Model.WinConMap.AssemblyPathCount candidate assembly paths; verify castability.</p>
                            <ul class="wincon-map-combo-list">
                                @foreach (var combo in Model.WinConMap.Combos)
                                {
                                    <li class="wincon-map-combo">
                                        <span class="wincon-map-combo__cards">@string.Join(", ", combo.CardNames)</span>
                                        <span class="wincon-map-combo__arrow" aria-hidden="true">&rarr;</span>
                                        <span class="wincon-map-combo__results">@string.Join(", ", combo.Results)</span>
                                        @if (combo.Band != WinConBand.Unknown)
                                        {
                                            <span class="wincon-map-band">typically comes online @formatWinConBand(combo.Band)</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        <div class="wincon-map-near">
                            <h4>One card away (not currently a win line)</h4>
                            @if (Model.WinConMap.NearCombos.Count > 0)
                            {
                                <ul>
                                    @foreach (var near in Model.WinConMap.NearCombos)
                                    {
                                        <li>missing @near.MissingCard (have: @string.Join(", ", near.CardsInDeck))</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="wincon-map-empty">None found by DeckFlow.</p>
                            }
                        </div>
                        @if (Model.WinConMap.OverallBand != WinConBand.Unknown)
                        {
                            <p class="wincon-map-band wincon-map-band--overall">Fastest candidate combo typically comes online @formatWinConBand(Model.WinConMap.OverallBand) (heuristic estimate &mdash; verify against the actual game plan).</p>
                        }
                        <div class="wincon-map-closers">
                            <h4>Non-combo closers to verify</h4>
                            @if (Model.WinConMap.ClosingCards.Count > 0)
                            {
                                <ul>
                                    @foreach (var card in Model.WinConMap.ClosingCards)
                                    {
                                        <li>@(card.Quantity > 1 ? $"{card.Quantity}x " : string.Empty)@card.Name</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="wincon-map-empty">None found by DeckFlow.</p>
                            }
                        </div>
                    </div>
                }
                <div class="stack">
                    <section class="result-panel nested-panel">
                        <h4>Overview</h4>
                        @if (!string.IsNullOrWhiteSpace(Model.AnalysisResponse.Format))
                        {
                            <p><strong>Format:</strong> @Model.AnalysisResponse.Format</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.AnalysisResponse.Commander))
                        {
                            <p><strong>Commander:</strong> @Model.AnalysisResponse.Commander</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.AnalysisResponse.GamePlan))
                        {
                            <p><strong>Game plan:</strong> @Model.AnalysisResponse.GamePlan</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.AnalysisResponse.Speed))
                        {
                            <p><strong>Speed:</strong> @Model.AnalysisResponse.Speed</p>
                        }
                        @if (Model.AnalysisResponse.EstimatedWinTurn > 0)
                        {
                            <p><strong>Earliest win turn:</strong> T@(Model.AnalysisResponse.EstimatedWinTurn)@(Model.AnalysisResponse.CanAnswerWinTurn ? " · can disrupt a win that turn" : " · cannot disrupt a win that turn")</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.AnalysisResponse.AssessedBracket))
                        {
                            <p><strong>Assessed bracket:</strong> @Model.AnalysisResponse.AssessedBracket</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.AnalysisResponse.BracketJustification))
                        {
                            <p><strong>Bracket rationale:</strong> @Model.AnalysisResponse.BracketJustification</p>
                        }
                        @if (Model.AnalysisResponse.PrimaryAxes.Count > 0)
                        {
                            <p><strong>Primary axes:</strong> @string.Join(", ", Model.AnalysisResponse.PrimaryAxes)</p>
                        }
                        @if (Model.AnalysisResponse.SynergyTags.Count > 0)
                        {
                            <p><strong>Synergy tags:</strong> @string.Join(", ", Model.AnalysisResponse.SynergyTags)</p>
                        }
                    </section>
                    <div class="sync-columns">
                        <section class="result-panel nested-panel">
                            <h4>Strengths</h4>
                            <ul>
                                @foreach (var item in Model.AnalysisResponse.Strengths)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        </section>

                        <section class="result-panel nested-panel">
                            <h4>Weaknesses</h4>
                            <ul>
                                @foreach (var item in Model.AnalysisResponse.Weaknesses)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        </section>
                    </div>

                    @if (Model.AnalysisResponse.DeckNeeds.Count > 0)
                    {
                        <section class="result-panel nested-panel">
                            <h4>Deck Needs</h4>
                            <ul>
                                @foreach (var item in Model.AnalysisResponse.DeckNeeds)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        </section>
                    }

                    @if (Model.AnalysisResponse.WeakSlots.Count > 0)
                    {
                        <section class="result-panel nested-panel">
                            <h4>Weak Slots</h4>
                            <ul>
                                @foreach (var slot in Model.AnalysisResponse.WeakSlots)
                                {
                                    <li><strong>@slot.Card</strong> — @slot.Reason</li>
                                }
                            </ul>
                        </section>
                    }

                    @if (Model.AnalysisResponse.QuestionAnswers.Count > 0)
                    {
                        <section class="result-panel nested-panel">
                            <h4>Question Answers</h4>
                            @foreach (var qa in Model.AnalysisResponse.QuestionAnswers)
                            {
                                <div class="result-panel nested-panel nested-panel--compact">
                                    <p><strong>Q@(qa.QuestionNumber): @qa.Question</strong></p>
                                    <p>@qa.Answer</p>
                                    @if (!string.IsNullOrWhiteSpace(qa.Basis))
                                    {
                                        <p><small>Basis: @qa.Basis</small></p>
                                    }
                                </div>
                            }
                        </section>
                    }

                    @if (Model.AnalysisResponse.DeckVersions.Count > 0)
                    {
                        <section class="result-panel nested-panel">
                            <h4>Deck Versions</h4>
                            @foreach (var version in Model.AnalysisResponse.DeckVersions)
                            {
                                <details class="result-panel nested-panel nested-panel--compact">
                                    <summary>@version.VersionName</summary>
                                    @if (version.CardsAdded.Count > 0)
                                    {
                                        <p><strong>Cards added:</strong></p>
                                        <ul>
                                            @foreach (var card in version.CardsAdded)
                                            {
                                                <li>@card</li>
                                            }
                                        </ul>
                                    }
                                    @if (version.CardsCut.Count > 0)
                                    {
                                        <p><strong>Cards cut:</strong></p>
                                        <ul>
                                            @foreach (var card in version.CardsCut)
                                            {
                                                <li>@card</li>
                                            }
                                        </ul>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(version.Decklist))
                                    {
                                        <p><strong>Decklist:</strong></p>
                                        <pre spellcheck="false">@version.Decklist</pre>
                                    }
                                </details>
                            }
                        </section>
                    }
                </div>
            </section>
        }

        <div class="prompt-step-footer">
            <button type="button" class="clear-cache-button" data-prompt-show-step="2">Back: Analysis</button>
            <button type="button" class="run-button" data-prompt-next-step="4">Next: Set Upgrades</button>
        </div>
    </section>

    <section class="result-panel prompt-step-panel" role="tabpanel" id="prompt-step-panel-4" aria-labelledby="prompt-step-tab-4" data-prompt-step="4">
        <div class="prompt-step-heading">
            <div>
                <p class="prompt-step-eyebrow">Step 4</p>
                <h2>Optional: Build the set-upgrade packet</h2>
                <p>This step is optional. Use it only when you want set-specific upgrade analysis after the main deck analysis is complete. The deck profile JSON from Step 3 is used automatically.</p>
            </div>
            <span class="prompt-step-badge">Optional final step</span>
        </div>

        <div class="prompt-instructions">
            <strong>What you do:</strong>
            <ol>
                <li>Select one set, or paste a condensed set packet.</li>
                <li>Click <code>Generate Set Upgrade Packet</code>, then paste <code>set-upgrade-analysis.txt</code> into @aiPlatform.DisplayName.</li>
                <li>Have @aiPlatform.DisplayName return the readable per-set analysis followed by a fenced <code>```json</code> block (the set analysis report).</li>
            </ol>
        </div>
        <label class="field">
            <span>Select one set to generate a compact set packet</span>
            <select name="SelectedSetCodes" data-df-select="search" data-set-options-select data-selected-codes="@string.Join(",", Model.Request.SelectedSetCodes.Take(1))">
            </select>
            <small class="sync-column__hint">Choose a single set here. The tool generates a compact candidate packet instead of a full set dump to keep the @aiPlatform.DisplayName prompt sendable.</small>
            <small class="sync-column__hint hidden" data-set-options-error>The Scryfall set catalog could not be loaded right now. You can still paste a condensed set packet manually below.</small>
        </label>
        <label class="field">
            <span>Set upgrade focus</span>
            <select name="SetUpgradeFocus" data-df-select>
                <option value="" selected="@(string.IsNullOrEmpty(Model.Request.SetUpgradeFocus))">Best additions (default)</option>
                <option value="lateral-moves" selected="@(string.Equals(Model.Request.SetUpgradeFocus, "lateral-moves", StringComparison.OrdinalIgnoreCase))">Lateral moves — same role, different card</option>
                <option value="strict-upgrades" selected="@(string.Equals(Model.Request.SetUpgradeFocus, "strict-upgrades", StringComparison.OrdinalIgnoreCase))">Strict upgrades — clearly better than what I have</option>
                <option value="both" selected="@(string.Equals(Model.Request.SetUpgradeFocus, "both", StringComparison.OrdinalIgnoreCase))">Both — lateral moves and strict upgrades</option>
            </select>
            <small class="sync-column__hint">Controls what @aiPlatform.DisplayName looks for. Default finds the best adds regardless of type. Lateral moves swap a card for something at a similar power level. Strict upgrades replace a card with something meaningfully better.</small>
        </label>
        <details class="result-panel nested-panel">
            <summary>Show condensed set packet override</summary>
            <label class="field">
                <span>Condensed set packet override</span>
                <textarea autocomplete="off" name="SetPacketText" spellcheck="false">@Model.Request.SetPacketText</textarea>
                <small class="sync-column__hint">Optional. Leave this blank to use the generated set packet from the selected sets.</small>
            </label>
        </details>
        <div class="toolbar prompt-step-actions">
            <button type="submit" class="run-button" data-prompt-submit-step="4" data-default-action>Generate Set Upgrade Packet</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.SetUpgradePromptText))
        {
            <section class="result-panel nested-panel">
                <div class="panel-heading">
                    <div>
                        <h3>set-upgrade-analysis.txt</h3>
                        <p>Paste this into @aiPlatform.DisplayName after you have a deck profile and a condensed set packet. It tells @aiPlatform.DisplayName to return both structured JSON and a condensed discussion summary text block that includes the per-set analysis.</p>
                    </div>
                    <div class="panel-heading__actions">
                        <button type="button" class="copy-button" data-copy-target="set-upgrade-output">Copy</button>
                        <button type="button" class="copy-button" data-expand-target="set-upgrade-output" aria-expanded="false">Expand</button>
                    </div>
                </div>
                <textarea class="prompt-artifact-textarea" autocomplete="off" id="set-upgrade-output" readonly spellcheck="false" data-prompt-result-anchor>@Model.SetUpgradePromptText</textarea>
                @await Html.PartialAsync("_PromptSplitTip", "set_upgrade_report")
            </section>
        }
        <details class="result-panel nested-panel">
            <summary>Optional follow-up JSON refresh prompt</summary>
            <div class="panel-heading">
                <div>
                    <p>Use this later only if you asked additional questions of your AI after the first set-upgrade response and need it to rebuild the updated <code>set_upgrade_report</code> JSON.</p>
                </div>
                <button type="button" class="copy-button" data-copy-target="set-upgrade-follow-up-output">Copy</button>
            </div>
            <textarea autocomplete="off" id="set-upgrade-follow-up-output" readonly spellcheck="false">@setUpgradeFollowUpPrompt</textarea>
        </details>
        <div class="prompt-step-footer">
            <button type="button" class="clear-cache-button" data-prompt-show-step="3">Back: Analysis Results</button>
            <button type="button" class="run-button" data-prompt-next-step="5">Next: Set Upgrade Results</button>
        </div>
    </section>

    <section class="result-panel prompt-step-panel" role="tabpanel" id="prompt-step-panel-5" aria-labelledby="prompt-step-tab-5" data-prompt-step="5">
        <div class="prompt-step-heading">
            <div>
                <p class="prompt-step-eyebrow">Step 5</p>
                <h2>Paste the set-upgrade JSON and view the results</h2>
                <p>Paste the fenced <code>set_upgrade_report</code> JSON block or raw JSON payload returned from @aiPlatform.DisplayName. You can use a saved JSON file here directly without filling out earlier steps.</p>
            </div>
            <span class="prompt-step-badge">Review results</span>
        </div>

        <label class="field">
            <span>Set upgrade report JSON</span>
            <textarea autocomplete="off" name="SetUpgradeResponseJson" spellcheck="false">@Model.Request.SetUpgradeResponseJson</textarea>
            <small class="sync-column__hint">Paste the fenced <code>```json</code> block or the raw JSON payload. Surrounding prose is safe to include.</small>
        </label>

        <div class="toolbar prompt-step-actions">
            <button type="submit" class="run-button" data-prompt-submit-step="5" data-default-action>Render Set Upgrade Results</button>
        </div>

        @if (Model.SetUpgradeResponse is not null)
        {
            <section class="result-panel nested-panel summary-panel" data-prompt-result-anchor data-print-result>
                <div class="toolbar prompt-step-actions">
                    <button type="submit" class="run-button" data-no-busy data-prompt-download-submit
                            formaction="@Url.Content("~/deck-analysis/download")"
                            formmethod="post"
                            formnovalidate>
                        Download session (.zip)
                    </button>
                    <button type="button" class="run-button prompt-print-button" data-no-busy data-prompt-print>
                        Print results
                    </button>
                </div>
                <h3>Set Upgrade Results</h3>
                <div class="stack">
                    @foreach (var set in Model.SetUpgradeResponse.Sets)
                    {
                        <section class="result-panel nested-panel">
                            <h4>
                                @if (!string.IsNullOrWhiteSpace(set.SetName))
                                {
                                    @set.SetName
                                    @if (!string.IsNullOrWhiteSpace(set.SetCode))
                                    {
                                        <text> (@set.SetCode)</text>
                                    }
                                }
                                else if (!string.IsNullOrWhiteSpace(set.SetCode))
                                {
                                    @set.SetCode
                                }
                                else
                                {
                                    <text>Set</text>
                                }
                            </h4>

                            @if (set.TopAdds.Count > 0)
                            {
                                <section class="result-panel nested-panel">
                                    <h5>Top Adds</h5>
                                    @foreach (var add in set.TopAdds)
                                    {
                                        <div class="result-panel nested-panel nested-panel--compact">
                                            <p><strong>@add.Card</strong></p>
                                            @{ var topAddCardText = resolveCardText(add); }
                                            @if (!string.IsNullOrWhiteSpace(topAddCardText))
                                            {
                                                <pre class="oracle-text set-upgrade-card-text" spellcheck="false">@topAddCardText</pre>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(add.Reason))
                                            {
                                                <p>@add.Reason</p>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(add.SuggestedCut))
                                            {
                                                <p><strong>Suggested cut:</strong> @add.SuggestedCut</p>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(add.CutReason))
                                            {
                                                <p><small>@add.CutReason</small></p>
                                            }
                                        </div>
                                    }
                                </section>
                            }

                            @if (set.Traps.Count > 0)
                            {
                                <section class="result-panel nested-panel">
                                    <h5>Traps</h5>
                                    <ul>
                                        @foreach (var trap in set.Traps)
                                        {
                                            <li><strong>@trap.Card</strong>@(string.IsNullOrWhiteSpace(trap.Reason) ? null : $" — {trap.Reason}")</li>
                                        }
                                    </ul>
                                </section>
                            }

                            @if (set.SpeculativeTests.Count > 0)
                            {
                                <section class="result-panel nested-panel">
                                    <h5>Speculative Tests</h5>
                                    <ul>
                                        @foreach (var spec in set.SpeculativeTests)
                                        {
                                            <li><strong>@spec.Card</strong>@(string.IsNullOrWhiteSpace(spec.Reason) ? null : $" — {spec.Reason}")</li>
                                        }
                                    </ul>
                                </section>
                            }
                        </section>
                    }

                    @if (Model.SetUpgradeResponse.FinalShortlist is not null
                         && (Model.SetUpgradeResponse.FinalShortlist.MustTest.Count > 0
                             || Model.SetUpgradeResponse.FinalShortlist.Optional.Count > 0
                             || Model.SetUpgradeResponse.FinalShortlist.Skip.Count > 0))
                    {
                        <section class="result-panel nested-panel">
                            <h4>Final Shortlist</h4>
                            <div class="sync-columns">
                                @if (Model.SetUpgradeResponse.FinalShortlist.MustTest.Count > 0)
                                {
                                    <section class="result-panel nested-panel">
                                        <h5>Must Test</h5>
                                        @foreach (var add in Model.SetUpgradeResponse.FinalShortlist.MustTest)
                                        {
                                            <div class="result-panel nested-panel nested-panel--compact">
                                                <p><strong>@add.Card</strong></p>
                                                @{ var shortlistCardText = resolveCardText(add); }
                                                @if (!string.IsNullOrWhiteSpace(shortlistCardText))
                                                {
                                                    <pre class="oracle-text set-upgrade-card-text" spellcheck="false">@shortlistCardText</pre>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(add.Reason))
                                                {
                                                    <p>@add.Reason</p>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(add.SuggestedCut))
                                                {
                                                    <p><strong>Cut:</strong> @add.SuggestedCut@(string.IsNullOrWhiteSpace(add.CutReason) ? null : $" — {add.CutReason}")</p>
                                                }
                                            </div>
                                        }
                                    </section>
                                }
                                @if (Model.SetUpgradeResponse.FinalShortlist.Optional.Count > 0)
                                {
                                    <section class="result-panel nested-panel">
                                        <h5>Optional</h5>
                                        @foreach (var add in Model.SetUpgradeResponse.FinalShortlist.Optional)
                                        {
                                            <div class="result-panel nested-panel nested-panel--compact">
                                                <p><strong>@add.Card</strong></p>
                                                @{ var shortlistCardText = resolveCardText(add); }
                                                @if (!string.IsNullOrWhiteSpace(shortlistCardText))
                                                {
                                                    <pre class="oracle-text set-upgrade-card-text" spellcheck="false">@shortlistCardText</pre>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(add.Reason))
                                                {
                                                    <p>@add.Reason</p>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(add.SuggestedCut))
                                                {
                                                    <p><strong>Cut:</strong> @add.SuggestedCut@(string.IsNullOrWhiteSpace(add.CutReason) ? null : $" — {add.CutReason}")</p>
                                                }
                                            </div>
                                        }
                                    </section>
                                }
                                @if (Model.SetUpgradeResponse.FinalShortlist.Skip.Count > 0)
                                {
                                    <section class="result-panel nested-panel">
                                        <h5>Skip</h5>
                                        <ul>
                                            @foreach (var card in Model.SetUpgradeResponse.FinalShortlist.Skip)
                                            {
                                                <li>@card</li>
                                            }
                                        </ul>
                                    </section>
                                }
                            </div>
                        </section>
                    }
                </div>
            </section>
        }

        <div class="prompt-step-footer">
            <button type="button" class="clear-cache-button" data-prompt-show-step="4">Back: Set Upgrades</button>
        </div>
    </section>
</form>

@if (FlagCache.IsEnabled("tool.deck-primer.enabled"))
{
    <aside class="related-tool-link"><p>Turn your findings into a guide with the <a href="@Url.Content("~/deck-primer")">Commander deck primer builder</a>.</p></aside>
}

@section Scripts {
    <script src="~/js/card-lookup.js" asp-append-version="true"></script>
    <script src="~/js/deck-input-store.js" asp-append-version="true"></script>
    <script src="~/js/busy-indicator.js" asp-append-version="true"></script>
    <script src="~/js/moxfield-extension-bridge.js" asp-append-version="true"></script>
    <script src="~/js/deck-sync.js" asp-append-version="true"></script>
}
