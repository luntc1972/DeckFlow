@model DeckFlow.Web.Models.CommanderCategoryViewModel
@{
    var commanderSpecified = !string.IsNullOrWhiteSpace(Model.Request.CommanderName);
    var hasResults = Model.CategorySummaries.Count > 0;
    var visibleSummaries = Model.CategorySummaries.Take(25).ToList();
    var overflowSummaries = Model.CategorySummaries.Skip(25).ToList();
    var showHint = commanderSpecified || !string.IsNullOrWhiteSpace(Model.ErrorMessage);
    var showNoResults = commanderSpecified && !hasResults && string.IsNullOrWhiteSpace(Model.ErrorMessage);
    ViewData["Title"] = "MTG Commander Category Reference";
    ViewData["Description"] = "Browse synergy and category knowledge for Commander cards, derived from aggregated public deck data. Reference for building and tuning EDH decks.";
}

<section class="hero">
    <h1>Category Reference</h1>
    <p class="lede">Search for a commander and see which Archidekt categories appear most often in decks that list it as their commander.</p>
</section>

@await Html.PartialAsync("_BusyIndicator")
@await Html.PartialAsync("_DeckToolTabs", Model.ActiveTab)

<div class="warning-banner">
    Commander selections are resolved from the cached Archidekt category database. The results reflect the categories recorded on decks that name the searched card as commander, so you can see what tags players most often assign when the card is leading a list.
</div>

<div class="error-banner @(string.IsNullOrWhiteSpace(Model.ErrorMessage) ? "hidden" : string.Empty)" role="alert" data-api-panel="commander-error">
    <span data-api-field="commander-error-text">@Model.ErrorMessage</span>
</div>

<div class="error-banner hidden" role="alert" data-api-panel="commander-search-error">
    <span data-api-field="commander-search-error-text"></span>
</div>

<form method="post" action="@Url.Content("~/commander-categories")" class="deck-form" data-cache-key="commander-categories" data-validate-lookup data-busy-title="Looking up commander categories" data-busy-message="Querying the cached category store." data-busy-progress="Checking cached store|Compiling commander categories|Finalizing results" data-busy-hold-final-step="true" data-suggestions-type="commander" data-suggestion-api="@Url.Content("~/api/suggestions/commander")">
    @Html.AntiForgeryToken()
    <div class="toolbar">
            <label class="mode-picker flex-grow">
                <span>Commander</span>
                <input id="commander-search-input" name="CommanderName" value="@Model.Request.CommanderName" placeholder="Bello, Bard of the Bramble" autocomplete="off" required />
        </label>
        <button type="submit" class="run-button" data-enable-on-ready>Show Categories</button>
        <button type="button" class="clear-cache-button" data-clear-cache>Clear</button>
    </div>
    <p class="mode-note">Type at least two letters to see intelligent suggestions for commanders backed by Scryfall.</p>
    <div class="mode-note">
        <span>Commander categories reflect the latest completed Archidekt harvest stored locally.</span>
    </div>
</form>

<div class="info-banner @(showHint ? string.Empty : "hidden")" data-api-panel="commander-hint">
    <p data-api-field="commander-hint-text">
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            @Model.ErrorMessage
        }
        else if (!string.IsNullOrWhiteSpace(Model.Request.CommanderName))
        {
            <text>Commander selections are resolved from the cached Archidekt category database built by completed harvests.</text>
        }
        else
        {
            <text>Enter a commander name and click Show Categories to search the cached data.</text>
        }
    </p>
</div>

<section class="result-panel @(hasResults ? string.Empty : "hidden")" data-api-panel="commander-results" id="commander-results-anchor">
    <div class="panel-heading">
        <div>
            <h2>Categories for @Model.Request.CommanderName</h2>
            <details class="info-tooltip">
                <summary>i</summary>
                <p>Categories sorted by the share of cached commander decks that include each category (descending).</p>
            </details>
            <p data-api-field="commander-cards-count">@Model.CategoryRows.Count cards contributed to this summary.</p>
            <p data-api-field="commander-deck-count">Derived from @Model.HarvestedDeckCount cached decks with @Model.CategorySummaries.Count filtered categories.</p>
            <p data-api-field="commander-card-deck-count">@Model.Request.CommanderName appears in <strong data-api-field="commander-card-count">@Model.CardDeckTotals.TotalDeckCount</strong> cached commander deck(s).</p>
        </div>
    </div>
    <table class="conflicts-table">
        <caption class="sr-only">Commander category breakdown sorted by deck share</caption>
        <thead>
            <tr>
                <th scope="col">Category</th>
                <th scope="col">% of decks</th>
                <th scope="col">Decks</th>
            </tr>
        </thead>
        <tbody data-api-field="commander-summary-body">
        @foreach (var summary in visibleSummaries)
        {
            <tr>
                <td>@summary.Category</td>
                <td>@($"{Math.Round(summary.DeckShare * 100)}%")</td>
                <td>@summary.DeckCount</td>
            </tr>
        }
        </tbody>
    </table>
    <details class="category-overflow @(overflowSummaries.Count == 0 ? "hidden" : string.Empty)" data-api-field="commander-summary-overflow">
        <summary data-api-field="commander-summary-overflow-label">Show @overflowSummaries.Count more categories</summary>
        <table class="conflicts-table">
            <caption class="sr-only">Additional commander categories sorted by deck share</caption>
            <thead>
                <tr>
                    <th scope="col">Category</th>
                    <th scope="col">% of decks</th>
                    <th scope="col">Decks</th>
                </tr>
            </thead>
            <tbody data-api-field="commander-summary-overflow-body">
            @foreach (var summary in overflowSummaries)
            {
                <tr>
                    <td>@summary.Category</td>
                    <td>@($"{Math.Round(summary.DeckShare * 100)}%")</td>
                    <td>@summary.DeckCount</td>
                </tr>
            }
            </tbody>
        </table>
    </details>
</section>

<div class="info-banner @(showNoResults ? string.Empty : "hidden")" data-api-panel="commander-no-results">
    <p data-api-field="commander-no-results-text">No commander categories for @Model.Request.CommanderName have been observed in the cached data yet.</p>
</div>

@section Scripts {
    <script src="~/js/busy-indicator.js" asp-append-version="true"></script>
    <script src="~/js/moxfield-extension-bridge.js" asp-append-version="true"></script>
    <script src="~/js/deck-sync.js" asp-append-version="true"></script>
    <script src="~/js/commander-search.js" asp-append-version="true"></script>
    <script src="~/js/category-suggestions.js" asp-append-version="true"></script>
}
