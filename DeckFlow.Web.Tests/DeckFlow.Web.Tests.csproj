<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="RichardSzalay.MockHttp" Version="7.1.0" />
    <PackageReference Include="RestSharp" Version="114.0.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="3.10.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeckFlow.Web\DeckFlow.Web.csproj">
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <!-- Why: reaches the DirectPush/Pull/Reconcile/Publish coordinators for the SYNC-16 round-trip
         harness (93-01 D-01). DeckFlow.Studio references only DeckFlow.Core, so Web.Tests -> {Web,
         Studio}, both -> Core, stays acyclic. -->
    <ProjectReference Include="..\DeckFlow.Studio\DeckFlow.Studio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Manabase\avatar-facts.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\DeckFlow.Web\Data\bracket-data.json" Link="Data\bracket-data.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
