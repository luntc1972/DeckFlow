@inject DeckFlow.Web.Services.IVersionService VersionService
@{
    var controllerName = (ViewContext.RouteData.Values["controller"] as string) ?? string.Empty;
    bool IsActive(string c) => string.Equals(controllerName, c, StringComparison.OrdinalIgnoreCase);
    string? ActiveAria(string c) => IsActive(c) ? "page" : null;
    string CurrentSectionLabel() => controllerName switch
    {
        "AdminLanding" => "Dashboard",
        "AdminFeedback" => "Feedback",
        "AdminHarvest" => "Harvest",
        "AdminAnalytics" => "Analytics",
        "AdminTools" => "Tools",
        "AdminFlags" => "Flags",
        "AdminContentKb" => "Content KB",
        "AdminYoutubeExport" => "YouTube Export",
        "AdminCreatorProfile" => "Deck Tendencies",
        "AdminCreatorStyle" => "Creator Style",
        _ => "Menu"
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* theme-color must be a literal; mirror --bg (#0f172a) so mobile browser chrome matches the dark admin shell. *@
    <meta name="theme-color" content="#0f172a" />
    <title>@ViewData["Title"] - DeckFlow Admin</title>
    <link rel="stylesheet" href="~/css/admin-common.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-mobile.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#admin-content">Skip to main content</a>
    <div class="admin-shell">
        <aside class="admin-sidebar" aria-label="Admin sections">
            <details class="admin-sidebar__disclosure">
                <summary class="admin-sidebar__toggle">
                    <span class="sr-only">Navigation menu — current section: @CurrentSectionLabel()</span>
                    <span aria-hidden="true">&#9776; @CurrentSectionLabel()</span>
                </summary>
                <a class="admin-sidebar__brand" href="@Url.Content("~/Admin")">DeckFlow Admin</a>
                <nav class="admin-sidebar__nav">
                    <a class="admin-sidebar__link" aria-current="@ActiveAria("AdminLanding")" href="@Url.Content("~/Admin")">Dashboard</a>
                    <div class="admin-sidebar__group" role="group" aria-labelledby="admin-nav-group-data">
                        <p id="admin-nav-group-data" class="admin-sidebar__group-label">Data</p>
                        <a class="admin-sidebar__link" aria-current="@ActiveAria("AdminHarvest")" href="@Url.Content("~/Admin/Harvest")">Harvest</a>
                        <a class="admin-sidebar__link" aria-current="@ActiveAria("AdminAnalytics")" href="@Url.Content("~/Admin/Analytics")">Analytics</a>
                        <a class="admin-sidebar__link" aria-current="@ActiveAria("AdminContentKb")" href="@Url.Content("~/Admin/ContentKb")">Content KB</a>
                    </div>
                    <div class="admin-sidebar__group" role="group" aria-labelledby="admin-nav-group-creators">
                        <p id="admin-nav-group-creators" class="admin-sidebar__group-label">Creators</p>
                        <a class="admin-sidebar__link" aria-current="@ActiveAria("AdminCreatorProfile")" href="@Url.Content("~/Admin/CreatorProfile")">Deck Tendencies</a>
                        <a class="admin-sidebar__link" aria-current="@ActiveAria("AdminCreatorStyle")" href="@Url.Content("~/Admin/CreatorStyle")">Creator Style</a>
                        <a class="admin-sidebar__link" aria-current="@ActiveAria("AdminYoutubeExport")" href="@Url.Content("~/Admin/YoutubeExport")">YouTube Export</a>
                    </div>
                    <div class="admin-sidebar__group" role="group" aria-labelledby="admin-nav-group-system">
                        <p id="admin-nav-group-system" class="admin-sidebar__group-label">System</p>
                        <a class="admin-sidebar__link" aria-current="@ActiveAria("AdminTools")" href="@Url.Content("~/Admin/Tools")">Tools</a>
                        <a class="admin-sidebar__link" aria-current="@ActiveAria("AdminFlags")" href="@Url.Content("~/Admin/Flags")">Flags</a>
                        <a class="admin-sidebar__link" aria-current="@ActiveAria("AdminFeedback")" href="@Url.Content("~/Admin/Feedback")">Feedback</a>
                    </div>
                </nav>
            </details>
        </aside>
        <header class="admin-topbar">
            <span class="admin-topbar__version">v@(VersionService.GetVersion())</span>
        </header>
        <main id="admin-content" class="admin-content" role="main">
            <div class="admin-page-header">
                <div class="admin-page-header__text">
                    <h1 class="admin-page-header__title">@((ViewData["Heading"] as string) is { Length: > 0 } heading ? heading : ViewData["Title"])</h1>
                    @if ((ViewData["Lede"] as string) is { Length: > 0 } lede)
                    {
                        <p class="admin-page-header__lede">@lede</p>
                    }
                </div>
                @if (IsSectionDefined("PageActions"))
                {
                    <div class="admin-page-header__actions">@await RenderSectionAsync("PageActions", required: false)</div>
                }
            </div>
            @RenderBody()
        </main>
    </div>
    @RenderSection("Scripts", required: false)
</body>
</html>
