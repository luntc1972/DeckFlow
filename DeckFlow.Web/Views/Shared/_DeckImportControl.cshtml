@model DeckImportControlModel
@{
    var isUrl = Model.Source == DeckFlow.Web.Models.DeckInputSource.PublicUrl;
}
<div class="field">
    <label for="@Model.IdPrefix-input-source">Input method</label>
    <select id="@Model.IdPrefix-input-source" name="DeckInputSource" data-df-select>
        <option value="@DeckFlow.Web.Models.DeckInputSource.PublicUrl" selected="@(isUrl ? "selected" : null)">Use public deck URL</option>
        <option value="@DeckFlow.Web.Models.DeckInputSource.PasteText" selected="@(!isUrl ? "selected" : null)">Paste text</option>
    </select>
</div>

<div class="field @(isUrl ? string.Empty : "hidden")" data-sync-panel="@Model.PanelKeyPrefix-deck-url">
    <label for="@Model.IdPrefix-deck-url">Archidekt or Moxfield deck URL</label>
    <input id="@Model.IdPrefix-deck-url" type="url" name="DeckUrl" spellcheck="false" autocomplete="off"
           placeholder="https://moxfield.com/decks/… or https://archidekt.com/decks/…" value="@Model.DeckUrl" />
    @await Html.PartialAsync("_DeckFlowBridgeHint")
</div>

<div class="field @(isUrl ? "hidden" : string.Empty)" data-sync-panel="@Model.PanelKeyPrefix-deck-text">
    <label for="@Model.IdPrefix-deck-text">@Model.TextLabel</label>
    <textarea id="@Model.IdPrefix-deck-text" name="DeckText" rows="6" spellcheck="false" autocomplete="off"
              placeholder="1 Sol Ring&#10;1 Command Tower&#10;…">@Model.DeckText</textarea>
</div>
