@using Microsoft.Extensions.Options
@using DeckFlow.Web.Configuration
@using DeckFlow.Web.Models
@inject IOptions<AiPlatformOptions> AiPlatformOptionsAccessor
@model string
@* AI target selector — radio pill group. Model is the currently-selected platform string.
   Accepted values: "ChatGPT", "Claude", "Gemini". Defaults to "ChatGPT" if model is null/empty.
   Iterates AiPlatform.All; Gemini radio is hidden unless DECKFLOW_GEMINI_ENABLED=true. If a
   persisted Gemini value lands here while disabled, falls back to ChatGPT so a real radio shows
   checked. Usage: @await Html.PartialAsync("_AiSelector", Model.Request.TargetAiPlatform)
*@
@{
    var geminiEnabled = AiPlatformOptionsAccessor.Value.GeminiEnabled;
    var selected = string.IsNullOrEmpty(Model) ? "ChatGPT" : Model;
    if (selected == "Gemini" && !geminiEnabled)
    {
        selected = "ChatGPT";
    }
}
<div class="ai-selector">
    <p class="ai-selector__heading">Analyze with</p>
    <div class="ai-selector__options" role="radiogroup" aria-label="AI analysis target">
        @foreach (var platform in AiPlatform.All)
        {
            @if (platform.Key == "Gemini" && !geminiEnabled)
            {
                continue;
            }
            <input type="radio" name="TargetAiPlatform" id="ai-@platform.Key.ToLowerInvariant()" value="@platform.Key"
                   class="sr-only ai-selector__option" checked="@(selected == platform.Key ? "checked" : null)" />
            <label for="ai-@platform.Key.ToLowerInvariant()" class="ai-selector__option-label">@platform.DisplayName</label>
        }
    </div>
</div>
